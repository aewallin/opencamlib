<!doctype html>
<!-- Generated by build.py. Edit demo.html.in, then regenerate index.html.
     Embedded OpenCAMLib is LGPL licensed; source: https://github.com/aewallin/opencamlib -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>OpenCAMLib · Toolpath lab</title>
    <style>
      * {
        box-sizing: border-box;
      }
      :root {
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: #273431;
        background: #f5f6f2;
        font-size: 14px;
        --ink: #273431;
        --muted: #77817b;
        --line: #dfe4dc;
        --accent: #247561;
        --orange: #ed773c;
      }
      body {
        margin: 0;
      }
      button,
      input,
      select {
        font: inherit;
      }
      button {
        cursor: pointer;
      }
      button:disabled {
        cursor: default;
        opacity: 0.45;
      }
      button,
      input,
      select {
        outline-offset: 3px;
      }
      button:focus-visible,
      input:focus-visible,
      select:focus-visible {
        outline: 2px solid var(--accent);
      }
      header {
        height: 76px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 30px;
        background: #fcfdf9;
        gap: 18px;
      }
      .brand {
        display: flex;
        gap: 13px;
        align-items: center;
      }
      .mark {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--accent);
        color: #fff;
      }
      .mark svg {
        width: 23px;
        height: 23px;
      }
      .brand strong {
        font-size: 16px;
        letter-spacing: -0.4px;
      }
      .brand small {
        display: block;
        color: var(--muted);
        font-size: 11px;
        margin-top: 3px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
        color: var(--muted);
        font-size: 12px;
      }
      .badge {
        border: 1px solid #c9ded3;
        border-radius: 30px;
        background: #edf5ef;
        color: #397461;
        padding: 7px 11px;
        white-space: nowrap;
      }
      .dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
        background: #43946f;
        margin-right: 6px;
      }
      main {
        display: grid;
        grid-template-columns: 302px minmax(0, 1fr);
        height: calc(100dvh - 76px);
        min-height: 650px;
      }
      .sidebar {
        background: #fcfdf9;
        border-right: 1px solid var(--line);
        overflow-y: auto;
        padding: 25px 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 1.3px;
        text-transform: uppercase;
        margin: 0 0 15px;
      }
      .section-title span {
        font:
          10px ui-monospace,
          monospace;
        color: #a3ada4;
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 3px;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-bottom: 13px;
      }
      label,
      .field-label {
        font-size: 12px;
        font-weight: 550;
        color: #505c55;
      }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      select,
      input[type="number"] {
        width: 100%;
        min-width: 0;
        border: 1px solid #dce2d8;
        background: white;
        color: var(--ink);
        border-radius: 7px;
        padding: 10px 11px;
        font-size: 12px;
        box-shadow: 0 1px 2px #20351b04;
      }
      select {
        padding-right: 20px;
      }
      .help {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.65;
        margin: 0;
      }
      .help a {
        color: var(--accent);
      }
      .input-unit {
        position: relative;
      }
      .input-unit input {
        padding-right: 31px;
      }
      .input-unit > span {
        position: absolute;
        right: 10px;
        top: 11px;
        color: #9aa397;
        font-size: 10px;
        pointer-events: none;
      }
      input[type="checkbox"],
      input[type="range"] {
        accent-color: var(--accent);
      }
      .check {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 400;
      }
      .check input {
        margin: 0;
      }
      .visibility {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
      }
      .primary {
        background: var(--accent);
        color: white;
        border: 0;
        border-radius: 8px;
        padding: 13px;
        font-weight: 600;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 2px 5px #205d3520;
      }
      .primary:hover {
        background: #1d6554;
      }
      .primary:disabled {
        opacity: 0.6;
      }
      .secondary {
        background: white;
        border: 1px solid var(--line);
        color: #58665d;
        border-radius: 7px;
        padding: 8px 11px;
        font-size: 11px;
      }
      .secondary:hover {
        background: #eef3eb;
      }
      .actions {
        margin-top: auto;
        position: sticky;
        bottom: 0;
        background: #fcfdf9;
        padding-top: 12px;
        box-shadow: 0 -12px 14px #fcfdf9;
      }
      .actions .help {
        text-align: center;
        margin-top: 10px;
      }
      .error {
        color: #a13e32;
        background: #fff0eb;
        border: 1px solid #f0c8bb;
        padding: 10px;
        border-radius: 7px;
        font-size: 12px;
        line-height: 1.5;
      }
      .workspace {
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 25px 28px 22px;
        gap: 17px;
        overflow: hidden;
      }
      .workspace-title {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
      }
      h1 {
        font-size: 24px;
        letter-spacing: -0.8px;
        font-weight: 550;
        margin: 0 0 6px;
      }
      h1 span {
        font-weight: 400;
        color: #9aa49a;
      }
      .subtitle {
        font-size: 12px;
        color: var(--muted);
        margin: 0;
      }
      .tiny-label {
        font:
          10px ui-monospace,
          monospace;
        letter-spacing: 1px;
        color: #8b978c;
        text-transform: uppercase;
      }
      .viewport {
        position: relative;
        flex: 1;
        min-height: 330px;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(#f4f6f1, #e8ede5);
      }
      #scene {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
      }
      .view-top {
        position: absolute;
        top: 17px;
        left: 18px;
        right: 18px;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        gap: 8px;
      }
      .model-chip {
        display: flex;
        align-items: center;
        gap: 9px;
        font:
          11px ui-monospace,
          monospace;
        color: #5e6e60;
        background: #fcfdf8df;
        border: 1px solid #dfe5da;
        border-radius: 6px;
        padding: 8px 10px;
        align-self: flex-start;
      }
      .view-buttons {
        display: flex;
        gap: 5px;
        pointer-events: auto;
      }
      .view-buttons button {
        background: #fbfcf8e8;
        border: 1px solid #d8e1d3;
        border-radius: 6px;
        color: #687661;
        font-size: 11px;
        padding: 7px 9px;
      }
      .view-buttons button:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .legend {
        position: absolute;
        left: 19px;
        bottom: 51px;
        font-size: 10px;
        color: #71806d;
        display: flex;
        gap: 15px;
      }
      .legend span {
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .swatch {
        height: 2px;
        width: 16px;
        display: inline-block;
        background: var(--orange);
      }
      .swatch.model {
        height: 7px;
        width: 7px;
        border-radius: 50%;
        background: #718879;
      }
      .view-hint {
        position: absolute;
        bottom: 17px;
        right: 18px;
        color: #8a9684;
        font-size: 10px;
      }
      .axis {
        position: absolute;
        right: 19px;
        bottom: 51px;
        font:
          11px ui-monospace,
          monospace;
        color: #7c8877;
        display: flex;
        gap: 9px;
      }
      .axis b:nth-child(1) {
        color: #bd7166;
      }
      .axis b:nth-child(2) {
        color: #639879;
      }
      .axis b:nth-child(3) {
        color: #638ba0;
      }
      .status {
        position: absolute;
        left: 19px;
        bottom: 15px;
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11px;
        color: #526d58;
        max-width: 65%;
      }
      .status.busy:before {
        content: "";
        width: 10px;
        height: 10px;
        border: 2px solid #bfd0be;
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fcfdf9;
        min-height: 83px;
      }
      .stat {
        padding: 16px 20px;
        min-width: 0;
      }
      .stat + .stat {
        border-left: 1px solid var(--line);
      }
      .stat label {
        display: block;
        color: #859080;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 7px;
      }
      .stat strong {
        font:
          23px ui-monospace,
          SFMono-Regular,
          Consolas,
          monospace;
        letter-spacing: -1px;
        font-weight: 400;
        color: #344d3c;
      }
      .stat small {
        font:
          11px ui-monospace,
          monospace;
        color: #8c9785;
        margin-left: 4px;
      }
      .footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 10px;
        color: #8b9585;
        line-height: 1.5;
      }
      .footer a {
        color: inherit;
      }
      .playback {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .playback input {
        flex: 1;
        min-width: 40px;
        height: 3px;
      }
      .playback button {
        width: 35px;
        height: 30px;
        font-size: 11px;
      }
      .playback output {
        font:
          10px ui-monospace,
          monospace;
        color: #8b9585;
        min-width: 42px;
        text-align: right;
      }
      .small-note {
        font-size: 10px;
        color: #97a08f;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
      [hidden] {
        display: none !important;
      }
      @media (min-width: 1500px) {
        .sidebar {
          padding: 30px;
        }
        main {
          grid-template-columns: 332px minmax(0, 1fr);
        }
        .workspace {
          padding: 30px 38px;
        }
      }
      @media (max-width: 850px) {
        header {
          padding: 0 18px;
          height: 65px;
        }
        .header-right > span:first-child {
          display: none;
        }
        main {
          height: auto;
          min-height: 0;
          grid-template-columns: 255px minmax(0, 1fr);
        }
        .sidebar {
          padding: 22px 17px;
        }
        .workspace {
          padding: 22px 17px;
          position: sticky;
          top: 0;
          height: calc(100dvh - 65px);
          min-height: 590px;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .stat {
          padding: 12px 15px;
        }
        .stat:nth-child(3) {
          border-left: 0;
          border-top: 1px solid var(--line);
        }
        .stat:nth-child(4) {
          border-top: 1px solid var(--line);
        }
        .stat strong {
          font-size: 20px;
        }
        .tiny-label,
        .view-hint,
        .footer > span:last-child {
          display: none;
        }
        h1 {
          font-size: 21px;
        }
        .view-top {
          left: 12px;
          right: 12px;
        }
        .model-chip {
          font-size: 9px;
        }
        .view-buttons {
          gap: 3px;
        }
        .view-buttons button {
          padding: 6px;
        }
        .legend {
          bottom: 45px;
        }
        .status {
          font-size: 10px;
          max-width: 90%;
        }
      }
      @media (max-width: 620px) {
        main {
          display: flex;
          flex-direction: column;
        }
        .workspace {
          order: -1;
          position: relative;
          height: 690px;
          min-height: 0;
          padding: 20px 14px 14px;
        }
        .sidebar {
          border-right: 0;
          border-top: 1px solid var(--line);
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 22px;
          padding: 24px 20px;
        }
        .actions {
          grid-column: 1/-1;
          margin: 0;
          position: static;
          box-shadow: none;
        }
        .brand strong {
          font-size: 14px;
        }
        .badge {
          font-size: 10px;
        }
        .header-right {
          gap: 0;
        }
        .viewport {
          min-height: 330px;
        }
        .stats {
          grid-template-columns: repeat(4, 1fr);
        }
        .stat {
          padding: 12px 8px;
        }
        .stat:nth-child(3) {
          border-top: 0;
          border-left: 1px solid var(--line);
        }
        .stat:nth-child(4) {
          border-top: 0;
        }
        .stat strong {
          font-size: 18px;
        }
        .stat label {
          font-size: 8px;
        }
        .stat small {
          font-size: 9px;
        }
        .view-hint {
          display: none;
        }
        .workspace-title .secondary {
          font-size: 10px;
        }
        .footer {
          font-size: 9px;
        }
        .pair {
          gap: 8px;
        }
        .sidebar .section-title {
          font-size: 10px;
          letter-spacing: 1px;
        }
      }
      .loading-overlay {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: grid;
        place-items: center;
        background: #eaf0e5b8;
        backdrop-filter: blur(3px);
        padding: 24px;
      }
      .loading-card {
        width: min(100%, 320px);
        text-align: center;
        background: #fcfdf9f5;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 26px;
        box-shadow: 0 12px 40px #25402b15;
      }
      .loading-spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #d6e4d7;
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 17px;
      }
      .loading-card strong {
        display: block;
        font-size: 15px;
        font-weight: 550;
        margin-bottom: 9px;
      }
      .loading-card p {
        font-size: 12px;
        color: #6b7d6b;
        line-height: 1.6;
        min-height: 38px;
        margin: 0 0 12px;
      }
      .loading-card progress {
        width: 100%;
        height: 5px;
        accent-color: var(--accent);
        margin-bottom: 14px;
      }
      .loading-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .loading-meta output {
        font:
          12px ui-monospace,
          monospace;
        color: #65775f;
      }
      .model-chip {
        max-width: 55%;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        display: block;
      }
      .model-section {
        grid-column: 1/-1;
      }
      .model-section .secondary {
        width: 100%;
      }
      .workspace-title h1 {
        overflow-wrap: anywhere;
      }
      .model-file {
        font-size: 11px;
        overflow-wrap: anywhere;
      }
      .viewport:focus-within {
        outline-offset: 2px;
      }
      .workspace {
        overflow-y: auto;
      }
      .tip-readout {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        padding: 12px 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fcfdf9;
        font-size: 11px;
        color: var(--muted);
      }
      .tip-readout > strong {
        font-size: 10px;
        font-weight: 550;
        text-transform: uppercase;
        letter-spacing: 0.7px;
      }
      .tip-coordinate {
        display: flex;
        align-items: baseline;
        gap: 6px;
      }
      .tip-coordinate b {
        font-size: 10px;
        font-weight: 500;
      }
      .tip-coordinate output {
        font:
          13px ui-monospace,
          monospace;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .tip-coordinate.z output {
        color: var(--accent);
        font-weight: 600;
      }
      .tip-coordinate small {
        font-size: 9px;
      }
      .tip-context {
        margin-left: auto;
        font-size: 10px;
        line-height: 1.5;
      }
      .tip-readout[data-empty="true"] {
        opacity: 0.65;
      }
      @media (max-width: 620px) {
        .tip-readout {
          gap: 8px 12px;
          padding: 10px;
        }
        .tip-readout > strong {
          width: 100%;
        }
        .tip-context {
          width: 100%;
          margin: 0;
        }
        .workspace {
          height: 790px;
        }
        .tip-coordinate output {
          font-size: 12px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *:before {
          animation-duration: 0s !important;
        }
      }
      .dimension-input input {
        padding-right: 57px;
        appearance: textfield;
        -moz-appearance: textfield;
      }
      .dimension-input input::-webkit-inner-spin-button,
      .dimension-input input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      .dimension-input > span {
        right: 33px;
      }
      .dimension-steps {
        position: absolute;
        right: 1px;
        top: 1px;
        bottom: 1px;
        width: 24px;
        display: grid;
        grid-template-rows: 1fr 1fr;
        border-left: 1px solid var(--line);
        border-radius: 0 6px 6px 0;
        overflow: hidden;
      }
      .dimension-steps button {
        border: 0;
        background: #f7f9f3;
        color: var(--accent);
        font-size: 9px;
        padding: 0;
        line-height: 1;
      }
      .dimension-steps button + button {
        border-top: 1px solid var(--line);
      }
      .dimension-steps button:hover:not(:disabled) {
        background: #e7efe4;
      }
      .dimension-steps button:focus-visible {
        outline-offset: -2px;
      }
      .sampling-presets {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 9px;
      }
      .sampling-presets button {
        padding: 8px 4px;
        line-height: 1.5;
      }
      .sampling-presets button small {
        display: block;
        font:
          10px ui-monospace,
          monospace;
        margin-top: 3px;
      }
      .sampling-presets button[aria-pressed="true"] {
        border-color: var(--accent);
        background: #edf5ef;
        color: var(--accent);
      }
      @media (max-width: 620px) {
        .sidebar {
          grid-template-columns: 1fr;
        }
      }
    </style>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
        }
      }
    </script>
  </head>
  <body>
    <header>
      <div class="brand">
        <div class="mark" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          >
            <path d="m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4" />
          </svg>
        </div>
        <div><strong>OpenCAMLib</strong><small>Toolpath lab</small></div>
      </div>
      <div class="header-right">
        <span>Geometry → motion</span
        ><span id="engine-badge" class="badge"
          ><span class="dot"></span>Loading engine</span
        >
      </div>
    </header>
    <main>
      <form class="sidebar" id="settings">
        <section class="model-section">
          <h2 class="section-title"><span>00</span>Model</h2>
          <div class="field">
            <label for="model-source">STL model</label
            ><select id="model-source">
              <option value="tux">Tux · included model</option>
              <option id="uploaded-option" value="upload" disabled>
                Uploaded STL
              </option>
            </select>
          </div>
          <button class="secondary" id="upload" type="button">
            ↑ Open STL file</button
          ><input id="stl-file" type="file" accept=".stl" hidden />
          <p class="help" style="margin-top: 9px">
            ASCII or binary STL · coordinates in mm.<br />Files stay on your
            device.
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>01</span>Strategy</h2>
          <div class="field">
            <label for="algorithm">Algorithm</label
            ><select id="algorithm">
              <option value="AdaptivePathDropCutter">
                Adaptive drop-cutter
              </option>
              <option value="PathDropCutter">Uniform drop-cutter</option>
              <option value="AdaptiveWaterline">Adaptive waterline</option>
              <option value="Waterline">Uniform waterline</option>
            </select>
          </div>
          <p class="help" id="algorithm-help">
            Follow the surface in parallel passes, adding samples where its
            shape changes.
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>02</span>Cutter</h2>
          <div class="field">
            <label for="cutter-preset">Cutter preset</label
            ><select id="cutter-preset">
              <option value="ball">0.8 mm ball nose</option>
              <option value="flat">1 mm flat end mill</option>
              <option value="bull">1 mm bull nose · R0.2</option>
              <option value="cone">1 mm V-bit · 60°</option>
              <option value="custom">Custom dimensions</option>
            </select>
          </div>
          <div class="field">
            <label for="cutter">Cutter type</label
            ><select id="cutter">
              <option value="BallCutter">Ball nose</option>
              <option value="CylCutter">Flat end mill</option>
              <option value="BullCutter">Bull nose</option>
              <option value="ConeCutter">Conical</option>
            </select>
          </div>
          <div class="pair">
            <div class="field">
              <label for="diameter">Diameter</label>
              <div class="input-unit">
                <input
                  id="diameter"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.8"
                  required
                /><span>mm</span>
              </div>
            </div>
            <div class="field">
              <label for="length">Length</label>
              <div class="input-unit">
                <input
                  id="length"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="10"
                  required
                /><span>mm</span>
              </div>
            </div>
          </div>
          <div class="field" id="radius-field" hidden>
            <label for="radius">Corner radius</label>
            <div class="input-unit">
              <input
                id="radius"
                type="number"
                min="0.000001"
                step="any"
                value="0.15"
              /><span>mm</span>
            </div>
          </div>
          <div class="field" id="angle-field" hidden>
            <label for="angle">Included tip angle</label>
            <div class="input-unit">
              <input
                id="angle"
                type="number"
                min="10"
                max="150"
                step="5"
                value="60"
              /><span>deg</span>
            </div>
          </div>
          <p class="help">
            Length is measured from the tip. Presets fit the loaded model;
            waterlines need enough length to reach its top. The preview shows
            the cutter used for the last generated path.
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>03</span>Sampling</h2>
          <div
            class="sampling-presets"
            id="sampling-presets"
            role="group"
            aria-label="Sampling presets"
            aria-describedby="sampling-preset-help"
          ></div>
          <p class="help" id="sampling-preset-help" style="margin-bottom: 13px">
            Sample / minimum spacing in mm. Fine is the default. Your values
            stay unchanged when loading another model.
          </p>
          <div class="pair">
            <div class="field">
              <label for="sampling">Sample spacing</label>
              <div class="input-unit">
                <input
                  id="sampling"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.05"
                  required
                /><span>mm</span>
              </div>
            </div>
            <div class="field" id="min-field">
              <label for="min-sampling">Min. spacing</label>
              <div class="input-unit">
                <input
                  id="min-sampling"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.005"
                /><span>mm</span>
              </div>
            </div>
          </div>
          <p
            class="help"
            id="sampling-help"
            style="margin-bottom: 13px"
            aria-live="polite"
          ></p>
          <p class="help" style="margin-bottom: 13px">
            Sampling distance is not machining tolerance. Surface finish also
            depends on pass spacing, step down and STL detail.
          </p>
          <div class="pair" id="path-fields">
            <div class="field">
              <label for="stepover">Pass spacing</label>
              <div class="input-unit">
                <input
                  id="stepover"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.4"
                /><span>mm</span>
              </div>
            </div>
            <div class="field">
              <label for="floor">Minimum Z</label>
              <div class="input-unit">
                <input id="floor" type="number" step="any" value="-3" /><span
                  >mm</span
                >
              </div>
            </div>
          </div>
          <div id="water-fields" hidden>
            <div class="pair">
              <div class="field">
                <label for="height">Start Z</label>
                <div class="input-unit">
                  <input id="height" type="number" step="any" value="2" /><span
                    >mm</span
                  >
                </div>
              </div>
              <div class="field">
                <label for="layers">Z levels</label
                ><input id="layers" type="number" min="1" step="1" value="1" />
              </div>
            </div>
            <div class="pair" style="margin-bottom: 13px">
              <button
                class="secondary"
                id="height-model-top"
                type="button"
                aria-controls="height"
              >
                Model top</button
              ><button
                class="secondary"
                id="height-top-step"
                type="button"
                aria-controls="height"
              >
                Top − step
              </button>
            </div>
            <div class="field">
              <label for="z-step">Step down</label>
              <div class="input-unit">
                <input
                  id="z-step"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.5"
                /><span>mm</span>
              </div>
            </div>
            <p class="help" style="margin-bottom: 13px">
              The exact top may have no contour. Top − step starts one step
              down. Start with one level to preview; each extra level repeats
              the calculation.
            </p>
          </div>
          <div class="field">
            <label for="threads">Compute threads</label
            ><select id="threads" disabled>
              <option value="1">1 thread</option>
            </select>
          </div>
          <p class="help" id="thread-help">
            Preparing the embedded CAM engine…
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>04</span>Display</h2>
          <div class="visibility">
            <label class="check"
              ><input id="show-model" type="checkbox" checked />Model</label
            ><label class="check"
              ><input id="show-path" type="checkbox" checked />Toolpath</label
            ><label class="check"
              ><input id="wireframe" type="checkbox" />Wireframe</label
            ><label class="check"
              ><input id="show-cutter" type="checkbox" />Cutter</label
            >
          </div>
        </section>
        <div class="actions">
          <p id="error" class="error" role="alert" hidden></p>
          <button class="primary" id="run" type="submit" disabled>
            <span aria-hidden="true">↗</span
            ><span id="run-label">Preparing model…</span>
          </button>
          <p class="help">All calculations stay in your browser.</p>
        </div>
      </form>
      <section class="workspace" aria-label="Model and toolpath">
        <div class="workspace-title">
          <div>
            <h1>
              <span id="model-title" style="color: inherit; font-weight: 550"
                >Tux</span
              >
              <span>/</span> surface study
            </h1>
            <p class="subtitle">Your surface. Four ways to follow it.</p>
          </div>
          <button class="secondary" id="download" disabled>
            ↓ Export points
          </button>
        </div>
        <div class="viewport" id="viewport">
          <canvas
            id="scene"
            aria-label="Interactive 3D model and toolpaths"
          ></canvas>
          <div class="view-top">
            <span class="model-chip" id="model-name">◇ gnu_tux_mod.stl</span>
            <div class="view-buttons" aria-label="Camera views">
              <button type="button" id="iso-view" title="Isometric view">
                Iso</button
              ><button type="button" id="top-view" title="Top view">Top</button
              ><button
                type="button"
                id="fit-view"
                title="Fit model and visible cutter"
              >
                Fit
              </button>
            </div>
          </div>
          <div class="legend">
            <span><i class="swatch model"></i>Surface</span
            ><span><i class="swatch"></i>Cutter-tip path</span>
          </div>
          <div class="axis" aria-hidden="true"><b>X</b><b>Y</b><b>Z</b></div>
          <div id="status" class="status busy" role="status" aria-live="polite">
            Loading the Tux model…
          </div>
          <span class="view-hint"
            >Drag to orbit · scroll to zoom · right-drag to pan</span
          >
          <div id="loading-overlay" class="loading-overlay" hidden>
            <div class="loading-card">
              <div class="loading-spinner" aria-hidden="true"></div>
              <strong id="loading-title">Generating toolpath</strong>
              <p id="loading-stage">Preparing calculation…</p>
              <progress
                id="loading-progress"
                aria-label="Completed Z levels"
              ></progress>
              <div class="loading-meta">
                <output id="loading-elapsed" aria-label="Elapsed time"
                  >0.0 s elapsed</output
                ><button type="button" class="secondary" id="loading-cancel">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="playback">
          <button
            class="secondary"
            id="play"
            disabled
            aria-label="Play cutter preview"
          >
            ▶</button
          ><label for="scrub" class="sr-only"
            >Cutter position along the toolpath</label
          ><input
            type="range"
            id="scrub"
            min="0"
            max="1000"
            step="1"
            value="0"
            disabled
          /><output id="scrub-value">0%</output
          ><span class="small-note">Preview</span>
        </div>
        <div
          class="tip-readout"
          id="tip-readout"
          data-empty="true"
          aria-label="Cutter tip position in model coordinates"
        >
          <strong>Cutter tip</strong
          ><span class="tip-coordinate"
            ><b>X</b
            ><output id="tip-x" aria-live="off" aria-label="Cutter tip X"
              >—</output
            ><small>mm</small></span
          ><span class="tip-coordinate"
            ><b>Y</b
            ><output id="tip-y" aria-live="off" aria-label="Cutter tip Y"
              >—</output
            ><small>mm</small></span
          ><span class="tip-coordinate z"
            ><b>Z</b
            ><output id="tip-z" aria-live="off" aria-label="Cutter tip Z"
              >—</output
            ><small>mm</small></span
          ><span class="tip-context" id="tip-context"
            >Generate a toolpath to inspect its coordinates.</span
          >
        </div>
        <div class="stats" aria-label="Last calculation statistics">
          <div class="stat">
            <label>Compute time</label><strong id="stat-time">—</strong
            ><small id="time-unit">ms</small>
          </div>
          <div class="stat">
            <label>Toolpath points</label><strong id="stat-points">—</strong>
          </div>
          <div class="stat">
            <label>Path length</label><strong id="stat-length">—</strong
            ><small>mm</small>
          </div>
          <div class="stat">
            <label id="paths-label">Passes</label
            ><strong id="stat-paths">—</strong>
          </div>
        </div>
        <div class="footer">
          <span id="model-info">Embedded Tux model · millimeters</span
          ><span id="detail-stats">OpenCAMLib · Three.js</span>
        </div>
      </section>
    </main>
    <noscript>This interactive demo requires JavaScript.</noscript>
    <script type="application/octet-stream" id="asset-stl">
      @@STL@@
    </script>
    <script type="application/octet-stream" id="asset-serial">
      @@SERIAL@@
    </script>
    <script type="application/octet-stream" id="asset-threaded">
      @@THREADED@@
    </script>
    <script type="text/plain" id="worker-source">
      let cam, surface;
      const release = value => value?.delete();
      function points(vector) {
        const result = [];
        try { for (let i = 0; i < vector.size(); i++) { const p = vector.get(i); try { result.push([p.x, p.y, p.z]); } finally { p.delete(); } } }
        finally { vector.delete(); }
        return result;
      }
      function readLoops(vector) {
        const result = [];
        try { for (let i = 0; i < vector.size(); i++) { const loop = points(vector.get(i)); if (loop.length > 1) { if (loop[0].some((v, j) => v !== loop[loop.length - 1][j])) loop.push([...loop[0]]); result.push(loop); } } }
        finally { vector.delete(); }
        return result;
      }
      self.onmessage = async ({data}) => {
        try {
          if (data.type === 'init') {
            cam = await ocl({ mainScriptUrlOrBlob: data.url, print() {}, printErr(message) { console.warn(message); } });
            surface = new cam.STLSurf();
            const input = new Float32Array(data.positions);
            const count = input.length / 9;
            for (let i = 0; i < count; i++) {
              const p = [];
              let triangle;
              try {
                for (let v = 0; v < 3; v++) { const o = i * 9 + v * 3; p.push(new cam.Point(input[o], input[o + 1], input[o + 2])); }
                triangle = new cam.Triangle(...p); surface.addTriangle(triangle);
              } finally { release(triangle); p.forEach(release); }
            }
            self.postMessage({type: 'ready', maxThreads: cam.maxThreads()});
            return;
          }
          if (data.type !== 'run') return;
          const {params: p, bounds: b} = data;
          const start = performance.now();
          let cutter, operation, path;
          let result, computeMs = 0;
          const levels = [];
          try {
            // ConeCutter's final argument is shaft length; the UI consistently uses
            // total length from the tip, including the cone.
            cutter = p.cutter === 'BullCutter' ? new cam.BullCutter(p.diameter, p.radius, p.length) :
              p.cutter === 'ConeCutter' ? new cam.ConeCutter(p.diameter, p.angle * Math.PI / 360, p.length - p.diameter / 2 / Math.tan(p.angle * Math.PI / 360)) : new cam[p.cutter](p.diameter, p.length);
            operation = new cam[p.algorithm]();
            operation.setSTL(surface); operation.setCutter(cutter); operation.setSampling(p.sampling); operation.setThreads(p.threads);
            if (p.algorithm.startsWith('Adaptive')) operation.setMinSampling(p.minSampling);
            if (p.algorithm.includes('Path')) {
              path = new cam.Path();
              const margin = p.diameter / 2;
              const low = b.min[1] - margin, high = b.max[1] + margin;
              const passes = Math.ceil((high - low) / p.stepover) + 1;
              for (let i = 0; i < passes; i++) {
                const y = low + i * (high - low) / (passes - 1);
                const a = new cam.Point(i % 2 ? b.max[0] + margin : b.min[0] - margin, y, p.floor);
                const z = new cam.Point(i % 2 ? b.min[0] - margin : b.max[0] + margin, y, p.floor);
                let line;
                try { line = new cam.Line(a, z); path.appendLine(line); } finally { release(line); a.delete(); z.delete(); }
              }
              operation.setPath(path); operation.setZ(p.floor);
              self.postMessage({type: 'progress', text: `Computing ${passes} raster passes…`});
              const t = performance.now(); operation.run(); computeMs = performance.now() - t;
              result = [];
              for (const point of points(operation.getPoints())) {
                let segment = result[result.length - 1];
                if (!segment || Math.abs(point[1] - segment[0][1]) > 1e-8) { segment = []; result.push(segment); }
                segment.push(point);
              }
            } else {
              result = [];
              for (let layer = 0; layer < p.layers; layer++) {
                const z = p.height - layer * p.zStep;
                self.postMessage({type: 'progress', text: `Computing Z level ${layer + 1} of ${p.layers} · Z ${z.toFixed(3)} mm`, completed: layer, total: p.layers});
                operation.setZ(z);
                const t = performance.now(); operation.run(); const ms = performance.now() - t; computeMs += ms;
                levels.push({z, computeMs: ms});
                result.push(...readLoops(operation.getLoops()));
                self.postMessage({type: 'progress', text: `Completed ${layer + 1} of ${p.layers} levels`, completed: layer + 1, total: p.layers});
              }
            }
            const totalMs = performance.now() - start;
            let length = 0, count = 0;
            for (const segment of result) {
              count += segment.length;
              for (let i = 1; i < segment.length; i++) length += Math.hypot(...segment[i].map((v, j) => v - segment[i - 1][j]));
            }
            const offsets = new Uint32Array(result.length + 1), coordinates = new Float64Array(count * 3);
            let cursor = 0;
            result.forEach((segment, i) => { offsets[i] = cursor; for (const point of segment) { coordinates.set(point, cursor * 3); cursor++; } });
            offsets[result.length] = cursor;
            self.postMessage({type: 'result', coordinates, offsets, stats: {computeMs, totalMs, length, count, paths: result.length, threads: operation.getThreads(), levels}}, [coordinates.buffer, offsets.buffer]);
          } finally { release(operation); release(path); release(cutter); }
        } catch (error) { self.postMessage({type: 'error', message: error.message || String(error)}); }
      };
    </script>
    <script>
      // Surface module/CDN failures instead of leaving the controls silently disabled.
      window.addEventListener("error", (event) => {
        const error = document.getElementById("error");
        error.hidden = false;
        error.textContent =
          event.message ||
          "A script failed to load. Check your connection and reload.";
      });
    </script>
    <script type="module">
      const $ = (id) => document.getElementById(id);
      const number = (id) => Number($(id).value);
      let worker,
        workerURL,
        libraryURL,
        stl,
        bounds,
        availableThreads = 1;
      let uploadedSTL,
        currentSource = "tux",
        modelName = "gnu_tux_mod.stl",
        loadingModel = false;
      let ready = false,
        busy = false,
        runStarted = 0,
        activeParams,
        lastResult,
        runTimer,
        engineGeneration = 0;
      let THREE,
        STLLoader,
        controls,
        renderer,
        scene,
        camera,
        model,
        pathGroup,
        cutterMesh,
        geometry,
        grid;
      let playing = false,
        playback = 0,
        lastFrame = 0;
      const fmt = new Intl.NumberFormat("en-US");
      const status = (message, spinning = false) => {
        $("status").textContent = message;
        $("status").classList.toggle("busy", spinning);
        $("loading-stage").textContent = message;
      };
      const showError = (message) => {
        $("error").textContent = message;
        $("error").hidden = false;
      };
      const clearError = () => {
        $("error").hidden = true;
      };

      async function inflate(id) {
        const bytes = Uint8Array.from(atob($(id).textContent.trim()), (c) =>
          c.charCodeAt(0),
        );
        return new Response(
          new Blob([bytes])
            .stream()
            .pipeThrough(new DecompressionStream("gzip")),
        ).arrayBuffer();
      }

      function conditionalFields() {
        const adaptive = $("algorithm").value.startsWith("Adaptive");
        const isPath = $("algorithm").value.includes("Path");
        for (const [id, visible] of [
          ["min-field", adaptive],
          ["path-fields", isPath],
          ["water-fields", !isPath],
          ["radius-field", $("cutter").value === "BullCutter"],
          ["angle-field", $("cutter").value === "ConeCutter"],
        ]) {
          $(id).hidden = !visible;
          $(id)
            .querySelectorAll("input")
            .forEach((input) => {
              input.disabled = !visible || busy || loadingModel;
            });
        }
        $("algorithm-help").textContent = isPath
          ? adaptive
            ? "Follow the surface in parallel passes, adding samples where its shape changes."
            : "Follow the surface with evenly spaced samples along parallel passes."
          : adaptive
            ? "Refine contours around changes in shape using the selected sampling threads. Complex surfaces can take longer than uniform waterline."
            : "Trace contours at fixed Z levels with a uniform grid of fibers.";
        for (const id of ["height-model-top", "height-top-step"])
          $(id).disabled = isPath || busy || loadingModel || !bounds;
        syncSamplingPresets();
        syncDimensionSteppers();
      }

      // Fixed physical distances: importing a larger part must not coarsen sampling.
      const samplingPresets = {
        preview: { label: "Preview", sampling: 0.25, minSampling: 0.05 },
        standard: { label: "Standard", sampling: 0.1, minSampling: 0.01 },
        fine: { label: "Fine", sampling: 0.05, minSampling: 0.005 },
        veryFine: { label: "Very fine", sampling: 0.02, minSampling: 0.002 },
      };

      function syncSamplingPresets() {
        const sampling = $("sampling").valueAsNumber,
          minimum = $("min-sampling").valueAsNumber;
        let name = "Custom";
        for (const button of $("sampling-presets").querySelectorAll("button")) {
          const preset = samplingPresets[button.dataset.preset];
          const selected =
            sampling === preset.sampling && minimum === preset.minSampling;
          button.setAttribute("aria-pressed", String(selected));
          button.disabled = busy || loadingModel || !ready;
          if (selected) name = preset.label;
        }
        $("sampling-help").textContent =
          `${name} sampling. ${$("algorithm").value.startsWith("Adaptive") ? "Adaptive refinement uses the minimum spacing where the shape changes." : "Uniform sampling uses sample spacing only; minimum spacing applies to adaptive methods."} Smaller values increase calculation time and output size.`;
      }

      function initSamplingPresets() {
        for (const [id, preset] of Object.entries(samplingPresets)) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "secondary";
          button.id = `sampling-${id}`;
          button.dataset.preset = id;
          button.setAttribute("aria-controls", "sampling min-sampling");
          button.setAttribute(
            "aria-label",
            `${preset.label}: sample spacing ${preset.sampling} mm, minimum spacing ${preset.minSampling} mm`,
          );
          button.append(preset.label);
          const values = document.createElement("small");
          values.textContent = `${preset.sampling} / ${preset.minSampling}`;
          button.append(values);
          button.addEventListener("click", () => {
            if (busy || loadingModel || !ready) return;
            for (const [input, value] of [
              [$("sampling"), preset.sampling],
              [$("min-sampling"), preset.minSampling],
            ]) {
              input.value = String(value);
              input.dispatchEvent(new Event("input", { bubbles: true }));
              input.dispatchEvent(new Event("change", { bubbles: true }));
            }
            clearError();
          });
          $("sampling-presets").append(button);
        }
        for (const id of ["sampling", "min-sampling"]) {
          $(id).addEventListener("input", syncSamplingPresets);
          $(id).addEventListener("change", syncSamplingPresets);
        }
        syncSamplingPresets();
      }

      function setStartFromModel(oneStepDown = false) {
        if (!bounds || busy || loadingModel || $("height").disabled) return;
        const step = oneStepDown ? $("z-step").valueAsNumber : 0;
        const height = bounds.max[2] - step;
        if (!Number.isFinite(height) || (oneStepDown && !(step > 0))) {
          showError(
            "Enter a positive, finite step down before using Top − step.",
          );
          return;
        }
        $("height").value = String(height);
        $("height").dispatchEvent(new Event("input", { bubbles: true }));
        $("height").dispatchEvent(new Event("change", { bubbles: true }));
        clearError();
      }

      // Keep step="any" for precise manual entries; HTML step=.1 would invalidate
      // values such as .04. The buttons and arrow keys add/subtract exactly .1 mm.
      function dimensionStepValue(input, direction) {
        const current = Number.isFinite(input.valueAsNumber)
          ? input.valueAsNumber
          : 0;
        return Number((current + direction * 0.1).toPrecision(15));
      }

      function canStepDimension(input, direction) {
        const next = dimensionStepValue(input, direction);
        return (
          !input.disabled &&
          Number.isFinite(next) &&
          (input.min === "" || next >= Number(input.min)) &&
          (input.max === "" || next <= Number(input.max))
        );
      }

      function syncDimensionSteppers() {
        document
          .querySelectorAll(".dimension-steps button")
          .forEach((button) => {
            button.disabled = !canStepDimension(
              $(button.dataset.input),
              Number(button.dataset.direction),
            );
          });
      }

      function initDimensionInputs() {
        for (const unit of document.querySelectorAll(".input-unit")) {
          if (unit.querySelector("span").textContent !== "mm") continue;
          const input = unit.querySelector("input"),
            label = document.querySelector(
              `label[for="${input.id}"]`,
            ).textContent;
          unit.classList.add("dimension-input");
          const buttons = document.createElement("div");
          buttons.className = "dimension-steps";
          const step = (direction) => {
            if (!canStepDimension(input, direction)) return;
            input.value = String(dimensionStepValue(input, direction));
            input.dispatchEvent(new Event("input", { bubbles: true }));
            input.dispatchEvent(new Event("change", { bubbles: true }));
          };
          for (const direction of [1, -1]) {
            const button = document.createElement("button");
            button.type = "button";
            button.textContent = direction === 1 ? "▲" : "▼";
            button.title = `${direction === 1 ? "Increase" : "Decrease"} ${label.toLowerCase()} by 0.1 mm`;
            button.setAttribute("aria-label", button.title);
            button.setAttribute("aria-controls", input.id);
            button.dataset.input = input.id;
            button.dataset.direction = direction;
            button.addEventListener("click", () => step(direction));
            buttons.append(button);
          }
          unit.append(buttons);
          input.addEventListener("input", syncDimensionSteppers);
          input.addEventListener("keydown", (event) => {
            if (event.key === "ArrowUp" || event.key === "ArrowDown") {
              event.preventDefault();
              step(event.key === "ArrowUp" ? 1 : -1);
            }
          });
        }
        syncDimensionSteppers();
      }

      function setBusy(value) {
        busy = value;
        $("settings").setAttribute("aria-busy", String(value));
        $("settings")
          .querySelectorAll("select,input[type=number]")
          .forEach((input) => {
            input.disabled = value || loadingModel;
          });
        $("upload").disabled = value || loadingModel;
        $("stl-file").disabled = value || loadingModel;
        conditionalFields();
        $("threads").disabled = value || loadingModel || availableThreads === 1;
        $("run-label").textContent = value
          ? "Cancel calculation"
          : "Generate toolpath";
        $("run").disabled = loadingModel || (!ready && !value);
        $("loading-overlay").hidden = !value && !loadingModel;
        $("viewport").setAttribute("aria-busy", String(value || loadingModel));
        $("loading-title").textContent = loadingModel
          ? "Loading model"
          : "Generating toolpath";
        $("loading-cancel").hidden = loadingModel;
        $("download").disabled =
          value || loadingModel || !lastResult?.stats.count;
        $("play").disabled = value || loadingModel || !lastResult?.stats.count;
        $("scrub").disabled = value || loadingModel || !lastResult?.stats.count;
        clearInterval(runTimer);
        if (value || loadingModel) {
          runStarted = performance.now();
          $("loading-progress").removeAttribute("value");
          $("loading-elapsed").textContent = "0.0 s elapsed";
          runTimer = setInterval(() => {
            const elapsed = ((performance.now() - runStarted) / 1000).toFixed(
              1,
            );
            $("loading-elapsed").textContent = `${elapsed} s elapsed`;
            if (busy) {
              $("stat-time").textContent = elapsed;
              $("time-unit").textContent = "s";
            }
          }, 100);
        }
      }

      function params() {
        const p = {
          algorithm: $("algorithm").value,
          cutter: $("cutter").value,
          diameter: number("diameter"),
          length: number("length"),
          radius: number("radius"),
          angle: number("angle"),
          sampling: number("sampling"),
          minSampling: number("min-sampling"),
          stepover: number("stepover"),
          floor: number("floor"),
          height: number("height"),
          layers: number("layers"),
          zStep: number("z-step"),
          threads: number("threads"),
        };
        if (p.cutter === "BullCutter" && p.radius >= p.diameter / 2)
          throw new Error(
            "The corner radius must be smaller than half the cutter diameter.",
          );
        if (p.algorithm.startsWith("Adaptive") && p.minSampling > p.sampling)
          throw new Error(
            "Minimum spacing must be no larger than sample spacing.",
          );
        if (
          p.cutter === "ConeCutter" &&
          p.length < p.diameter / 2 / Math.tan((p.angle * Math.PI) / 360)
        )
          throw new Error("Increase the cutter length to fit the conical tip.");
        if (!p.algorithm.includes("Path")) {
          if (!Number.isSafeInteger(p.layers) || p.layers < 1)
            throw new Error(
              "Z levels must be a positive whole number within the browser’s integer range.",
            );
          if (
            !Number.isFinite(p.height) ||
            !Number.isFinite(p.zStep) ||
            p.zStep <= 0 ||
            !Number.isFinite(p.height - (p.layers - 1) * p.zStep)
          )
            throw new Error(
              "Start Z, step down, and the final Z level must be finite, with a positive step down.",
            );
          const lowestZ = p.height - (p.layers - 1) * p.zStep;
          const reach = Math.max(0, bounds.max[2] - lowestZ);
          if (p.length < reach)
            throw new Error(
              `For these waterline levels, increase cutter length to at least ${(Math.ceil(reach * 10) / 10).toFixed(1)} mm. A shorter cutter can produce false interior contours because it does not reach the model’s top from the lowest Z level.`,
            );
        }
        return p;
      }

      async function startEngine() {
        const generation = ++engineGeneration;
        ready = false;
        $("run").disabled = true;
        $("run-label").textContent = "Preparing model…";
        status("Preparing the CAM engine…", true);
        worker = new Worker(workerURL);
        worker.onerror = (event) => {
          if (generation !== engineGeneration) return;
          ready = false;
          loadingModel = false;
          setBusy(false);
          showError(
            event.message ||
              "The calculation worker stopped unexpectedly. Reload to restart.",
          );
          status("Engine error");
        };
        worker.onmessage = ({ data }) => {
          if (generation !== engineGeneration) return;
          if (data.type === "ready") {
            ready = true;
            availableThreads = data.maxThreads;
            const previous = Number($("threads").value);
            $("threads").replaceChildren(
              ...Array.from(
                { length: availableThreads },
                (_, i) =>
                  new Option(`${i + 1} thread${i ? "s" : ""}`, String(i + 1)),
              ),
            );
            $("threads").value = String(
              generation === 1
                ? availableThreads
                : Math.min(previous, availableThreads),
            );
            $("engine-badge").innerHTML =
              `<span class="dot"></span>${availableThreads > 1 ? "Multithreaded WASM" : "Single-thread WASM"}`;
            $("thread-help").textContent =
              availableThreads > 1
                ? "Up to four threads. The preview stays responsive while calculations run."
                : "Running in a background worker. Use the included local server to enable more threads.";
            loadingModel = false;
            setBusy(false);
            status(
              lastResult
                ? "Ready for another pass"
                : "Model ready. Choose a strategy and generate a path.",
            );
            if (!lastResult && generation === 1) $("settings").requestSubmit();
          } else if (data.type === "progress") {
            status(data.text, true);
            if (data.total) {
              $("loading-progress").max = data.total;
              $("loading-progress").value = data.completed;
            }
          } else if (data.type === "result") {
            lastResult = {
              ...data,
              model: modelName,
              params: { ...activeParams },
            };
            setBusy(false);
            displayResult();
          } else if (data.type === "error") {
            if (loadingModel) ready = false;
            loadingModel = false;
            setBusy(false);
            showError(data.message);
            status("Calculation failed. Adjust the settings and try again.");
          }
        };
        const copy = geometry.getAttribute("position").array.slice().buffer;
        worker.postMessage({ type: "init", url: libraryURL, positions: copy }, [
          copy,
        ]);
      }

      function cancel() {
        worker?.terminate();
        playing = false;
        $("play").textContent = "▶";
        setBusy(false);
        status("Calculation cancelled");
        if (lastResult) updateStats(lastResult.stats);
        else {
          $("stat-time").textContent = "—";
          $("time-unit").textContent = "ms";
        }
        startEngine();
      }

      function generate(event) {
        event?.preventDefault();
        if (busy) {
          cancel();
          return;
        }
        if (!ready) return;
        try {
          clearError();
          activeParams = params();
          playing = false;
          $("play").textContent = "▶";
          setBusy(true);
          status("Building the spatial index…", true);
          worker.postMessage({ type: "run", params: activeParams, bounds });
        } catch (error) {
          showError(error.message);
        }
      }

      function clearGroup(group) {
        for (const child of [...group.children]) {
          child.geometry?.dispose();
          child.material?.dispose();
          group.remove(child);
        }
      }

      const cutterPresets = {
        ball: {
          cutter: "BallCutter",
          diameter: 0.8,
          length: 10,
          radius: 0.15,
          angle: 60,
        },
        flat: {
          cutter: "CylCutter",
          diameter: 1,
          length: 10,
          radius: 0.2,
          angle: 60,
        },
        bull: {
          cutter: "BullCutter",
          diameter: 1,
          length: 10,
          radius: 0.2,
          angle: 60,
        },
        cone: {
          cutter: "ConeCutter",
          diameter: 1,
          length: 10,
          radius: 0.2,
          angle: 60,
        },
      };
      function applyPreset() {
        const preset = cutterPresets[$("cutter-preset").value];
        if (!preset) return;
        for (const [id, value] of Object.entries(preset))
          $(id).value = String(value);
        if (bounds) {
          const bottom = Math.min(
            bounds.min[2],
            Number.isFinite(number("floor")) ? number("floor") : bounds.min[2],
          );
          $("length").value = String(
            Math.ceil(Math.max(preset.length, bounds.max[2] - bottom) * 10) /
              10,
          );
        }
        conditionalFields();
        clearError();
      }

      function parseModel(buffer) {
        if (!buffer.byteLength) throw new Error("This STL file is empty.");
        const g = new STLLoader().parse(buffer);
        try {
          const positions = g.getAttribute("position");
          if (!positions || !positions.count || positions.count % 3)
            throw new Error("No complete triangles were found in this STL.");
          const a = new THREE.Vector3(),
            b = new THREE.Vector3(),
            c = new THREE.Vector3();
          for (let i = 0; i < positions.count; i += 3) {
            a.fromBufferAttribute(positions, i);
            b.fromBufferAttribute(positions, i + 1);
            c.fromBufferAttribute(positions, i + 2);
            if (
              ![a.x, a.y, a.z, b.x, b.y, b.z, c.x, c.y, c.z].every(
                Number.isFinite,
              )
            )
              throw new Error("The STL contains invalid vertex coordinates.");
            if (b.sub(a).cross(c.sub(a)).lengthSq() === 0)
              throw new Error(
                `Triangle ${i / 3 + 1} has zero area. Repair the STL and try again.`,
              );
          }
          g.computeVertexNormals();
          g.computeBoundingBox();
          return g;
        } catch (error) {
          g.dispose();
          throw error;
        }
      }

      function updateModelView() {
        bounds = {
          min: geometry.boundingBox.min.toArray(),
          max: geometry.boundingBox.max.toArray(),
        };
        const sizes = bounds.max.map((v, i) => v - bounds.min[i]),
          extent = Math.max(...sizes);
        $("height-model-top").title = `Set Start Z to ${bounds.max[2]} mm`;
        $("height-top-step").title =
          "Set Start Z to the model’s highest Z minus the current step down";
        $("model-info").textContent =
          `${fmt.format(geometry.getAttribute("position").count / 3)} triangles · ${sizes.map((v) => v.toFixed(1)).join(" × ")} mm`;
        $("model-title").textContent =
          currentSource === "tux" ? "Tux" : modelName.replace(/\.stl$/i, "");
        $("model-name").textContent = `◇ ${modelName}`;
        $("model-name").title = modelName;
        if (grid) {
          scene.remove(grid);
          grid.geometry.dispose();
          grid.material.dispose();
        }
        grid = new THREE.GridHelper(extent * 2.5, 60, 0xb5c2ae, 0xd6decf);
        grid.rotation.x = Math.PI / 2;
        grid.position.set(
          (bounds.min[0] + bounds.max[0]) / 2,
          (bounds.min[1] + bounds.max[1]) / 2,
          bounds.min[2] - extent / 300,
        );
        grid.material.transparent = true;
        grid.material.opacity = 0.65;
        scene.add(grid);
        camera.near = extent / 10000;
        camera.far = extent * 100;
        camera.updateProjectionMatrix();
        controls.minDistance = extent / 100;
        controls.maxDistance = extent * 20;
        cameraView();
      }

      function clearResult() {
        lastResult = undefined;
        playing = false;
        playback = 0;
        $("play").textContent = "▶";
        $("scrub").value = "0";
        clearGroup(pathGroup);
        if (cutterMesh) {
          scene.remove(cutterMesh);
          cutterMesh.geometry.dispose();
          cutterMesh.material.dispose();
          cutterMesh = undefined;
        }
        for (const id of [
          "stat-time",
          "stat-points",
          "stat-length",
          "stat-paths",
        ])
          $(id).textContent = "—";
        $("time-unit").textContent = "ms";
        $("detail-stats").textContent = "OpenCAMLib · Three.js";
        updateCutter();
      }

      async function selectModel(buffer, name, source) {
        if (busy || loadingModel) return;
        loadingModel = true;
        setBusy(false);
        clearError();
        status("Reading and validating STL triangles…", true);
        try {
          await new Promise(requestAnimationFrame);
          const next = parseModel(buffer);
          worker?.terminate();
          ++engineGeneration;
          ready = false;
          model.geometry = next;
          geometry.dispose();
          geometry = next;
          modelName = name;
          currentSource = source;
          $("model-source").value = source;
          if (source === "upload") {
            uploadedSTL = { buffer, name };
            $("uploaded-option").disabled = false;
            $("uploaded-option").textContent = name;
          }
          clearResult();
          updateModelView();
          const extent = Math.max(
            ...bounds.max.map((v, i) => v - bounds.min[i]),
          );
          const defaults =
            source === "tux"
              ? { stepover: 0.4, floor: -3, height: 2, "z-step": 0.5 }
              : {
                  stepover: extent / 30,
                  floor: bounds.min[2] - extent / 50,
                  height: bounds.max[2],
                  "z-step": Math.max(
                    (bounds.max[2] - bounds.min[2]) / 10,
                    extent / 100,
                  ),
                };
          // Preserve the exact top; rounding upward can put a waterline above the STL.
          for (const [id, value] of Object.entries(defaults))
            $(id).value = String(
              id === "height" ? value : Number(value.toPrecision(7)),
            );
          $("layers").value = "1";
          // Refit preset lengths to this geometry; preserve explicitly customized tools.
          applyPreset();
          await startEngine();
        } catch (error) {
          loadingModel = false;
          setBusy(false);
          $("model-source").value = currentSource;
          showError(`Could not load STL: ${error.message}`);
          status("Model unchanged. Choose another STL.");
        }
      }

      function updateStats(s) {
        $("stat-time").textContent =
          s.computeMs < 1000
            ? s.computeMs.toFixed(0)
            : (s.computeMs / 1000).toFixed(2);
        $("time-unit").textContent = s.computeMs < 1000 ? "ms" : "s";
        $("stat-points").textContent = fmt.format(s.count);
        $("stat-length").textContent = s.length.toFixed(1);
        $("stat-paths").textContent = fmt.format(s.paths);
        $("paths-label").textContent = lastResult.params.algorithm.includes(
          "Path",
        )
          ? "Passes"
          : "Contours";
        $("detail-stats").textContent =
          `${(s.totalMs / 1000).toFixed(2)} s incl. setup · up to ${s.threads} compute thread${s.threads > 1 ? "s" : ""}`;
      }

      function displayResult() {
        const { coordinates: positions, offsets, stats: s } = lastResult;
        clearGroup(pathGroup);
        for (let i = 0; i < offsets.length - 1; i++) {
          const points = new Float32Array(
            positions.subarray(offsets[i] * 3, offsets[i + 1] * 3),
          );
          const g = new THREE.BufferGeometry();
          g.setAttribute("position", new THREE.BufferAttribute(points, 3));
          const line = new THREE.Line(
            g,
            new THREE.LineBasicMaterial({ color: 0xe86b32, depthTest: true }),
          );
          line.renderOrder = 2;
          pathGroup.add(line);
        }
        updateStats(s);
        $("download").disabled = !s.count;
        $("play").disabled = !s.count;
        $("scrub").disabled = !s.count;
        playback = 0;
        $("scrub").value = "0";
        makeCutter();
        updateCutter();
        status(
          s.count
            ? `Toolpath ready · ${fmt.format(s.count)} points`
            : "No contours at these heights. Try a different start Z.",
        );
      }

      function makeCutter() {
        if (cutterMesh) {
          scene.remove(cutterMesh);
          cutterMesh.geometry.dispose();
          cutterMesh.material.dispose();
        }
        const p = lastResult.params,
          r = p.diameter / 2;
        const profile = [new THREE.Vector2(0, 0)];
        if (p.cutter === "BallCutter" || p.cutter === "BullCutter") {
          const fillet = p.cutter === "BallCutter" ? r : p.radius;
          const angle = Math.acos(1 - Math.min(p.length, fillet) / fillet);
          for (let i = 0; i <= 20; i++) {
            const a = (i * angle) / 20;
            profile.push(
              new THREE.Vector2(
                r - fillet + fillet * Math.sin(a),
                fillet * (1 - Math.cos(a)),
              ),
            );
          }
        } else if (p.cutter === "ConeCutter")
          profile.push(
            new THREE.Vector2(r, r / Math.tan((p.angle * Math.PI) / 360)),
          );
        else profile.push(new THREE.Vector2(r, 0));
        profile.push(
          new THREE.Vector2(profile[profile.length - 1].x, p.length),
          new THREE.Vector2(0, p.length),
        );
        cutterMesh = new THREE.Mesh(
          new THREE.LatheGeometry(profile, 32),
          new THREE.MeshStandardMaterial({
            color: 0x2a8175,
            metalness: 0.45,
            roughness: 0.28,
            transparent: true,
            opacity: 0.72,
          }),
        );
        cutterMesh.rotation.x = Math.PI / 2;
        scene.add(cutterMesh);
      }

      function updateCutter() {
        $("scrub-value").textContent = `${Math.round(playback * 100)}%`;
        const count = lastResult?.stats.count || 0;
        $("tip-readout").dataset.empty = String(!count);
        if (!count) {
          for (const axis of ["x", "y", "z"]) {
            $(`tip-${axis}`).textContent = "—";
            $(`tip-${axis}`).removeAttribute("title");
          }
          $("tip-context").textContent =
            "Generate a toolpath to inspect its coordinates.";
          if (cutterMesh) cutterMesh.visible = false;
          return;
        }
        const sample = Math.min(count - 1, Math.floor(playback * (count - 1))),
          i = sample * 3;
        const { coordinates, offsets, params: p, stats: s } = lastResult;
        for (const [axis, j] of [
          ["x", 0],
          ["y", 1],
          ["z", 2],
        ]) {
          const value = coordinates[i + j];
          $(`tip-${axis}`).textContent =
            Math.abs(value) < 0.0005 ? "0.000" : value.toFixed(3);
          $(`tip-${axis}`).title = `${value} mm`;
        }
        let low = 0,
          high = offsets.length - 1;
        while (low + 1 < high) {
          const mid = (low + high) >>> 1;
          if (offsets[mid] <= sample) low = mid;
          else high = mid;
        }
        const level = s.levels.findIndex(
          (entry) => entry.z === coordinates[i + 2],
        );
        $("tip-context").textContent =
          `${p.algorithm.includes("Path") ? "Pass" : "Contour"} ${low + 1}/${s.paths}${level >= 0 ? ` · Z level ${level + 1}/${s.levels.length}` : ""} · Point ${fmt.format(sample + 1)}/${fmt.format(count)}`;
        if (cutterMesh) {
          cutterMesh.position.fromArray(coordinates, i);
          cutterMesh.visible = $("show-cutter").checked;
        }
      }

      function cameraView(top = false) {
        if (!camera || !bounds) return;
        const box = new THREE.Box3(
          new THREE.Vector3(...bounds.min),
          new THREE.Vector3(...bounds.max),
        );
        if (cutterMesh?.visible) box.expandByObject(cutterMesh);
        const center = box.getCenter(new THREE.Vector3()),
          radius = box.getSize(new THREE.Vector3()).length() / 2;
        const halfFov = Math.atan(
          Math.tan((camera.fov * Math.PI) / 360) * Math.min(1, camera.aspect),
        );
        const distance = (radius / Math.sin(halfFov)) * 1.12;
        camera.near = radius / 5000;
        camera.far = radius * 200;
        camera.updateProjectionMatrix();
        controls.minDistance = radius / 50;
        controls.maxDistance = radius * 40;
        camera.up.set(0, 0, 1);
        const direction = top
          ? new THREE.Vector3(0, -0.0001, 1)
          : new THREE.Vector3(0.7, -1, 0.95);
        camera.position
          .copy(center)
          .addScaledVector(direction.normalize(), distance);
        controls.target.copy(center);
        camera.lookAt(center);
        controls.update();
      }

      async function initView() {
        [THREE] = await Promise.all([import("three")]);
        const [{ OrbitControls }, loader] = await Promise.all([
          import("three/addons/controls/OrbitControls.js"),
          import("three/addons/loaders/STLLoader.js"),
        ]);
        STLLoader = loader.STLLoader;
        geometry = parseModel(stl);
        scene = new THREE.Scene();
        renderer = new THREE.WebGLRenderer({
          canvas: $("scene"),
          antialias: true,
          alpha: true,
        });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        renderer.setClearColor(0, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.3;
        camera = new THREE.PerspectiveCamera(35, 1, 0.01, 500);
        camera.up.set(0, 0, 1);
        controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.08;
        controls.minDistance = 2;
        controls.maxDistance = 100;
        scene.add(new THREE.AmbientLight(0xffffff, 1.2));
        const key = new THREE.DirectionalLight(0xfff6e4, 3);
        key.position.set(-8, -12, 22);
        scene.add(key);
        const fill = new THREE.DirectionalLight(0xd9ebff, 2);
        fill.position.set(15, 8, 10);
        scene.add(fill);
        model = new THREE.Mesh(
          geometry,
          new THREE.MeshStandardMaterial({
            color: 0x789283,
            metalness: 0.22,
            roughness: 0.48,
            side: THREE.DoubleSide,
            polygonOffset: true,
            polygonOffsetFactor: 1,
            polygonOffsetUnits: 1,
          }),
        );
        scene.add(model);
        updateModelView();
        pathGroup = new THREE.Group();
        scene.add(pathGroup);
        const resize = () => {
          const rect = $("viewport").getBoundingClientRect();
          renderer.setSize(rect.width, rect.height, false);
          camera.aspect = rect.width / rect.height;
          camera.updateProjectionMatrix();
        };
        new ResizeObserver(resize).observe($("viewport"));
        resize();
        cameraView();
        renderer.setAnimationLoop((time) => {
          const dt = Math.min(0.1, (time - lastFrame) / 1000);
          lastFrame = time;
          if (playing && lastResult) {
            playback = Math.min(1, playback + dt / 30);
            $("scrub").value = String(Math.round(playback * 1000));
            updateCutter();
            if (playback === 1) {
              playing = false;
              $("play").textContent = "▶";
            }
          }
          controls.update();
          renderer.render(scene, camera);
        });
      }

      $("settings").addEventListener("submit", generate);
      $("algorithm").addEventListener("change", conditionalFields);
      $("height-model-top").addEventListener("click", () =>
        setStartFromModel(),
      );
      $("height-top-step").addEventListener("click", () =>
        setStartFromModel(true),
      );
      $("cutter-preset").addEventListener("change", applyPreset);
      for (const id of ["cutter", "diameter", "length", "radius", "angle"])
        $(id).addEventListener("input", () => {
          $("cutter-preset").value = "custom";
          conditionalFields();
        });
      $("cutter").addEventListener("change", () => {
        $("cutter-preset").value = "custom";
        conditionalFields();
      });
      $("loading-cancel").addEventListener("click", cancel);
      $("upload").addEventListener("click", () => {
        $("stl-file").value = "";
        $("stl-file").click();
      });
      $("stl-file").addEventListener("change", async () => {
        const file = $("stl-file").files[0];
        if (!file || busy || loadingModel) return;
        try {
          if (!file.name.toLowerCase().endsWith(".stl"))
            throw new Error("Choose a file with the .stl extension.");
          if (file.size > 100 * 1024 * 1024)
            throw new Error(
              "This browser demo supports STL files up to 100 MB.",
            );
          await selectModel(await file.arrayBuffer(), file.name, "upload");
        } catch (error) {
          showError(error.message);
        }
      });
      $("model-source").addEventListener("change", () => {
        if ($("model-source").value === "tux")
          selectModel(stl, "gnu_tux_mod.stl", "tux");
        else if (uploadedSTL)
          selectModel(uploadedSTL.buffer, uploadedSTL.name, "upload");
      });
      $("show-model").addEventListener("change", () => {
        if (model) model.visible = $("show-model").checked;
      });
      $("show-path").addEventListener("change", () => {
        if (pathGroup) pathGroup.visible = $("show-path").checked;
      });
      $("wireframe").addEventListener("change", () => {
        if (model) model.material.wireframe = $("wireframe").checked;
      });
      $("show-cutter").addEventListener("change", updateCutter);
      $("top-view").addEventListener("click", () => cameraView(true));
      $("iso-view").addEventListener("click", () => cameraView());
      $("fit-view").addEventListener("click", () => cameraView());
      $("scrub").addEventListener("input", () => {
        playing = false;
        $("play").textContent = "▶";
        playback = number("scrub") / 1000;
        $("show-cutter").checked = true;
        updateCutter();
      });
      $("play").addEventListener("click", () => {
        if (playback >= 1) playback = 0;
        playing = !playing;
        $("play").textContent = playing ? "Ⅱ" : "▶";
        $("show-cutter").checked = true;
        updateCutter();
      });
      $("download").addEventListener("click", () => {
        const { coordinates, offsets } = lastResult;
        const paths = Array.from({ length: offsets.length - 1 }, (_, i) =>
          Array.from({ length: offsets[i + 1] - offsets[i] }, (_, j) =>
            Array.from(
              coordinates.subarray(
                (offsets[i] + j) * 3,
                (offsets[i] + j + 1) * 3,
              ),
            ),
          ),
        );
        const data = {
          model: lastResult.model,
          units: "mm",
          parameters: lastResult.params,
          statistics: lastResult.stats,
          paths,
        };
        const url = URL.createObjectURL(
          new Blob([JSON.stringify(data, null, 2)], {
            type: "application/json",
          }),
        );
        const a = document.createElement("a");
        a.href = url;
        a.download = `${lastResult.model.replace(/\.stl$/i, "").replace(/[^a-z0-9_-]/gi, "_")}-${lastResult.params.algorithm}.json`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
      window.addEventListener("beforeunload", () => {
        worker?.terminate();
        URL.revokeObjectURL(workerURL);
        URL.revokeObjectURL(libraryURL);
      });

      try {
        initDimensionInputs();
        initSamplingPresets();
        $("upload").disabled = true;
        $("model-source").disabled = true;
        if (!("DecompressionStream" in window))
          throw new Error(
            "This demo needs a current browser with gzip decompression support.",
          );
        const threaded =
          crossOriginIsolated && typeof SharedArrayBuffer !== "undefined";
        const [mesh, library] = await Promise.all([
          inflate("asset-stl"),
          inflate(threaded ? "asset-threaded" : "asset-serial"),
        ]);
        stl = mesh;
        libraryURL = URL.createObjectURL(
          new Blob([library], { type: "application/javascript" }),
        );
        workerURL = URL.createObjectURL(
          new Blob([library, "\n", $("worker-source").textContent], {
            type: "application/javascript",
          }),
        );
        await initView();
        conditionalFields();
        await startEngine();
      } catch (error) {
        showError(
          `${error.message}. Check that your browser can reach cdn.jsdelivr.net, then reload.`,
        );
        status("Unable to load the demo");
        $("engine-badge").textContent = "Loading failed";
      }
    </script>
  </body>
</html>
