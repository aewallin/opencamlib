<!doctype html>
<!-- Generated by build.py from index.html.in and the JavaScript source files.
     Embedded OpenCAMLib is LGPL licensed; source: https://github.com/aewallin/opencamlib -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>OpenCAMLib · Toolpath lab</title>
    <style>
      * {
        box-sizing: border-box;
      }
      :root {
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: #273431;
        background: #f5f6f2;
        font-size: 14px;
        --ink: #273431;
        --muted: #77817b;
        --line: #dfe4dc;
        --accent: #247561;
        --orange: #ed773c;
      }
      body {
        margin: 0;
      }
      button,
      input,
      select {
        font: inherit;
      }
      button {
        cursor: pointer;
      }
      button:disabled {
        cursor: default;
        opacity: 0.45;
      }
      button,
      input,
      select {
        outline-offset: 3px;
      }
      button:focus-visible,
      input:focus-visible,
      select:focus-visible {
        outline: 2px solid var(--accent);
      }
      header {
        height: 76px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 30px;
        background: #fcfdf9;
        gap: 18px;
      }
      .brand {
        display: flex;
        gap: 13px;
        align-items: center;
      }
      .mark {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--accent);
        color: #fff;
      }
      .mark svg {
        width: 23px;
        height: 23px;
      }
      .brand strong {
        font-size: 16px;
        letter-spacing: -0.4px;
      }
      .brand small {
        display: block;
        color: var(--muted);
        font-size: 11px;
        margin-top: 3px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
        color: var(--muted);
        font-size: 12px;
      }
      .badge {
        border: 1px solid #c9ded3;
        border-radius: 30px;
        background: #edf5ef;
        color: #397461;
        padding: 7px 11px;
        white-space: nowrap;
      }
      .dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
        background: #43946f;
        margin-right: 6px;
      }
      main {
        display: grid;
        grid-template-columns: 302px minmax(0, 1fr);
        height: calc(100dvh - 76px);
        min-height: 650px;
      }
      .sidebar {
        background: #fcfdf9;
        border-right: 1px solid var(--line);
        overflow-y: auto;
        padding: 25px 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 1.3px;
        text-transform: uppercase;
        margin: 0 0 15px;
      }
      .section-title span {
        font:
          10px ui-monospace,
          monospace;
        color: #a3ada4;
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 3px;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-bottom: 13px;
      }
      label,
      .field-label {
        font-size: 12px;
        font-weight: 550;
        color: #505c55;
      }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      select,
      input[type="number"] {
        width: 100%;
        min-width: 0;
        border: 1px solid #dce2d8;
        background: white;
        color: var(--ink);
        border-radius: 7px;
        padding: 10px 11px;
        font-size: 12px;
        box-shadow: 0 1px 2px #20351b04;
      }
      select {
        padding-right: 20px;
      }
      .help {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.65;
        margin: 0;
      }
      .help a {
        color: var(--accent);
      }
      .input-unit {
        position: relative;
      }
      .input-unit input {
        padding-right: 31px;
      }
      .input-unit > span {
        position: absolute;
        right: 10px;
        top: 11px;
        color: #9aa397;
        font-size: 10px;
        pointer-events: none;
      }
      input[type="checkbox"],
      input[type="range"] {
        accent-color: var(--accent);
      }
      .check {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 400;
      }
      .check input {
        margin: 0;
      }
      .visibility {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
      }
      .primary {
        background: var(--accent);
        color: white;
        border: 0;
        border-radius: 8px;
        padding: 13px;
        font-weight: 600;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 2px 5px #205d3520;
      }
      .primary:hover {
        background: #1d6554;
      }
      .primary:disabled {
        opacity: 0.6;
      }
      .secondary {
        background: white;
        border: 1px solid var(--line);
        color: #58665d;
        border-radius: 7px;
        padding: 8px 11px;
        font-size: 11px;
      }
      .secondary:hover {
        background: #eef3eb;
      }
      .actions {
        margin-top: auto;
        position: sticky;
        bottom: 0;
        background: #fcfdf9;
        padding-top: 12px;
        box-shadow: 0 -12px 14px #fcfdf9;
      }
      .actions .help {
        text-align: center;
        margin-top: 10px;
      }
      .error {
        color: #a13e32;
        background: #fff0eb;
        border: 1px solid #f0c8bb;
        padding: 10px;
        border-radius: 7px;
        font-size: 12px;
        line-height: 1.5;
      }
      .workspace {
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 25px 28px 22px;
        gap: 17px;
        overflow: hidden;
      }
      .workspace-title {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
      }
      h1 {
        font-size: 24px;
        letter-spacing: -0.8px;
        font-weight: 550;
        margin: 0 0 6px;
      }
      h1 span {
        font-weight: 400;
        color: #9aa49a;
      }
      .subtitle {
        font-size: 12px;
        color: var(--muted);
        margin: 0;
      }
      .tiny-label {
        font:
          10px ui-monospace,
          monospace;
        letter-spacing: 1px;
        color: #8b978c;
        text-transform: uppercase;
      }
      .viewport {
        position: relative;
        flex: 1;
        min-height: 330px;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(#f4f6f1, #e8ede5);
      }
      #scene {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
      }
      .view-top {
        position: absolute;
        top: 17px;
        left: 18px;
        right: 18px;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        gap: 8px;
      }
      .model-chip {
        display: flex;
        align-items: center;
        gap: 9px;
        font:
          11px ui-monospace,
          monospace;
        color: #5e6e60;
        background: #fcfdf8df;
        border: 1px solid #dfe5da;
        border-radius: 6px;
        padding: 8px 10px;
        align-self: flex-start;
      }
      .view-buttons {
        display: flex;
        gap: 5px;
        pointer-events: auto;
      }
      .view-buttons button {
        background: #fbfcf8e8;
        border: 1px solid #d8e1d3;
        border-radius: 6px;
        color: #687661;
        font-size: 11px;
        padding: 7px 9px;
      }
      .view-buttons button:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .legend {
        position: absolute;
        left: 19px;
        bottom: 51px;
        font-size: 10px;
        color: #71806d;
        display: flex;
        gap: 15px;
      }
      .legend span {
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .swatch {
        height: 2px;
        width: 16px;
        display: inline-block;
        background: var(--orange);
      }
      .swatch.model {
        height: 7px;
        width: 7px;
        border-radius: 50%;
        background: #718879;
      }
      .view-hint {
        position: absolute;
        bottom: 17px;
        right: 18px;
        color: #8a9684;
        font-size: 10px;
      }
      .axis {
        position: absolute;
        right: 19px;
        bottom: 51px;
        font:
          11px ui-monospace,
          monospace;
        color: #7c8877;
        display: flex;
        gap: 9px;
      }
      .axis b:nth-child(1) {
        color: #bd7166;
      }
      .axis b:nth-child(2) {
        color: #639879;
      }
      .axis b:nth-child(3) {
        color: #638ba0;
      }
      .status {
        position: absolute;
        left: 19px;
        bottom: 15px;
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11px;
        color: #526d58;
        max-width: 65%;
      }
      .status.busy:before {
        content: "";
        width: 10px;
        height: 10px;
        border: 2px solid #bfd0be;
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fcfdf9;
        min-height: 83px;
      }
      .stat {
        padding: 16px 20px;
        min-width: 0;
      }
      .stat + .stat {
        border-left: 1px solid var(--line);
      }
      .stat label {
        display: block;
        color: #859080;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 7px;
      }
      .stat strong {
        font:
          23px ui-monospace,
          SFMono-Regular,
          Consolas,
          monospace;
        letter-spacing: -1px;
        font-weight: 400;
        color: #344d3c;
      }
      .stat small {
        font:
          11px ui-monospace,
          monospace;
        color: #8c9785;
        margin-left: 4px;
      }
      .footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 10px;
        color: #8b9585;
        line-height: 1.5;
      }
      .footer a {
        color: inherit;
      }
      .playback {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .playback input {
        flex: 1;
        min-width: 40px;
        height: 3px;
      }
      .playback button {
        width: 35px;
        height: 30px;
        font-size: 11px;
      }
      .playback output {
        font:
          10px ui-monospace,
          monospace;
        color: #8b9585;
        min-width: 42px;
        text-align: right;
      }
      .small-note {
        font-size: 10px;
        color: #97a08f;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
      [hidden] {
        display: none !important;
      }
      @media (min-width: 1500px) {
        .sidebar {
          padding: 30px;
        }
        main {
          grid-template-columns: 332px minmax(0, 1fr);
        }
        .workspace {
          padding: 30px 38px;
        }
      }
      @media (max-width: 850px) {
        header {
          padding: 0 18px;
          height: 65px;
        }
        .header-right > span:first-child {
          display: none;
        }
        main {
          height: auto;
          min-height: 0;
          grid-template-columns: 255px minmax(0, 1fr);
        }
        .sidebar {
          padding: 22px 17px;
        }
        .workspace {
          padding: 22px 17px;
          position: sticky;
          top: 0;
          height: calc(100dvh - 65px);
          min-height: 590px;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .stat {
          padding: 12px 15px;
        }
        .stat:nth-child(3) {
          border-left: 0;
          border-top: 1px solid var(--line);
        }
        .stat:nth-child(4) {
          border-top: 1px solid var(--line);
        }
        .stat strong {
          font-size: 20px;
        }
        .tiny-label,
        .view-hint,
        .footer > span:last-child {
          display: none;
        }
        h1 {
          font-size: 21px;
        }
        .view-top {
          left: 12px;
          right: 12px;
        }
        .model-chip {
          font-size: 9px;
        }
        .view-buttons {
          gap: 3px;
        }
        .view-buttons button {
          padding: 6px;
        }
        .legend {
          bottom: 45px;
        }
        .status {
          font-size: 10px;
          max-width: 90%;
        }
      }
      @media (max-width: 620px) {
        main {
          display: flex;
          flex-direction: column;
        }
        .workspace {
          order: -1;
          position: relative;
          height: 690px;
          min-height: 0;
          padding: 20px 14px 14px;
        }
        .sidebar {
          border-right: 0;
          border-top: 1px solid var(--line);
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 22px;
          padding: 24px 20px;
        }
        .actions {
          grid-column: 1/-1;
          margin: 0;
          position: static;
          box-shadow: none;
        }
        .brand strong {
          font-size: 14px;
        }
        .badge {
          font-size: 10px;
        }
        .header-right {
          gap: 0;
        }
        .viewport {
          min-height: 330px;
        }
        .stats {
          grid-template-columns: repeat(4, 1fr);
        }
        .stat {
          padding: 12px 8px;
        }
        .stat:nth-child(3) {
          border-top: 0;
          border-left: 1px solid var(--line);
        }
        .stat:nth-child(4) {
          border-top: 0;
        }
        .stat strong {
          font-size: 18px;
        }
        .stat label {
          font-size: 8px;
        }
        .stat small {
          font-size: 9px;
        }
        .view-hint {
          display: none;
        }
        .workspace-title .secondary {
          font-size: 10px;
        }
        .footer {
          font-size: 9px;
        }
        .pair {
          gap: 8px;
        }
        .sidebar .section-title {
          font-size: 10px;
          letter-spacing: 1px;
        }
      }
      .loading-overlay {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: grid;
        place-items: center;
        background: #eaf0e5b8;
        backdrop-filter: blur(3px);
        padding: 24px;
      }
      .loading-card {
        width: min(100%, 320px);
        text-align: center;
        background: #fcfdf9f5;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 26px;
        box-shadow: 0 12px 40px #25402b15;
      }
      .loading-spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #d6e4d7;
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 17px;
      }
      .loading-card strong {
        display: block;
        font-size: 15px;
        font-weight: 550;
        margin-bottom: 9px;
      }
      .loading-card p {
        font-size: 12px;
        color: #6b7d6b;
        line-height: 1.6;
        min-height: 38px;
        margin: 0 0 12px;
      }
      .loading-card progress {
        width: 100%;
        height: 5px;
        accent-color: var(--accent);
        margin-bottom: 14px;
      }
      .loading-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .loading-meta output {
        font:
          12px ui-monospace,
          monospace;
        color: #65775f;
      }
      .model-chip {
        max-width: 55%;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        display: block;
      }
      .model-section {
        grid-column: 1/-1;
      }
      .model-section .secondary {
        width: 100%;
      }
      .workspace-title h1 {
        overflow-wrap: anywhere;
      }
      .model-file {
        font-size: 11px;
        overflow-wrap: anywhere;
      }
      .viewport:focus-within {
        outline-offset: 2px;
      }
      .workspace {
        overflow-y: auto;
      }
      .tip-readout {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        padding: 12px 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fcfdf9;
        font-size: 11px;
        color: var(--muted);
      }
      .tip-readout > strong {
        font-size: 10px;
        font-weight: 550;
        text-transform: uppercase;
        letter-spacing: 0.7px;
      }
      .tip-coordinate {
        display: flex;
        align-items: baseline;
        gap: 6px;
      }
      .tip-coordinate b {
        font-size: 10px;
        font-weight: 500;
      }
      .tip-coordinate output {
        font:
          13px ui-monospace,
          monospace;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .tip-coordinate.z output {
        color: var(--accent);
        font-weight: 600;
      }
      .tip-coordinate small {
        font-size: 9px;
      }
      .tip-context {
        margin-left: auto;
        font-size: 10px;
        line-height: 1.5;
      }
      .tip-readout[data-empty="true"] {
        opacity: 0.65;
      }
      @media (max-width: 620px) {
        .tip-readout {
          gap: 8px 12px;
          padding: 10px;
        }
        .tip-readout > strong {
          width: 100%;
        }
        .tip-context {
          width: 100%;
          margin: 0;
        }
        .workspace {
          height: 790px;
        }
        .tip-coordinate output {
          font-size: 12px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *:before {
          animation-duration: 0s !important;
        }
      }
      .dimension-input input {
        padding-right: 57px;
        appearance: textfield;
        -moz-appearance: textfield;
      }
      .dimension-input input::-webkit-inner-spin-button,
      .dimension-input input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      .dimension-input > span {
        right: 33px;
      }
      .dimension-steps {
        position: absolute;
        right: 1px;
        top: 1px;
        bottom: 1px;
        width: 24px;
        display: grid;
        grid-template-rows: 1fr 1fr;
        border-left: 1px solid var(--line);
        border-radius: 0 6px 6px 0;
        overflow: hidden;
      }
      .dimension-steps button {
        border: 0;
        background: #f7f9f3;
        color: var(--accent);
        font-size: 9px;
        padding: 0;
        line-height: 1;
      }
      .dimension-steps button + button {
        border-top: 1px solid var(--line);
      }
      .dimension-steps button:hover:not(:disabled) {
        background: #e7efe4;
      }
      .dimension-steps button:focus-visible {
        outline-offset: -2px;
      }
      .sampling-presets {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 9px;
      }
      .sampling-presets button {
        padding: 8px 4px;
        line-height: 1.5;
      }
      .sampling-presets button small {
        display: block;
        font:
          10px ui-monospace,
          monospace;
        margin-top: 3px;
      }
      .sampling-presets button[aria-pressed="true"] {
        border-color: var(--accent);
        background: #edf5ef;
        color: var(--accent);
      }
      .export-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      .export-actions button {
        flex-shrink: 0;
        white-space: nowrap;
      }
      dialog {
        width: min(720px, calc(100% - 24px));
        max-height: calc(100dvh - 32px);
        overflow-y: auto;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 24px;
        color: var(--ink);
        background: #fcfdf9;
        box-shadow: 0 20px 80px #172e3233;
      }
      dialog::backdrop {
        background: #172e3280;
      }
      .dialog-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
      }
      .dialog-heading h2 {
        margin: 0;
        font-size: 20px;
      }
      #gcode-summary {
        margin-bottom: 18px;
        overflow-wrap: anywhere;
      }
      #gcode-form .input-unit input {
        padding-right: 62px;
      }
      #gcode-form .field {
        margin-bottom: 0;
      }
      #gcode-form .pair {
        margin-bottom: 16px;
      }
      #gcode-preview {
        width: 100%;
        height: 170px;
        resize: vertical;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 12px;
        margin: 8px 0;
        background: #f4f6f0;
        color: var(--ink);
        font:
          11px/1.6 ui-monospace,
          monospace;
      }
      #gcode-output {
        margin-top: 18px;
      }
      #gcode-form .primary {
        margin-top: 16px;
      }
      @media (max-width: 620px) {
        .sidebar {
          grid-template-columns: 1fr;
        }
      }
    </style>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
        }
      }
    </script>
  </head>
  <body>
    <header>
      <div class="brand">
        <div class="mark" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          >
            <path d="m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4" />
          </svg>
        </div>
        <div><strong>OpenCAMLib</strong><small>Toolpath lab</small></div>
      </div>
      <div class="header-right">
        <span>Geometry → motion</span
        ><span id="engine-badge" class="badge"
          ><span class="dot"></span>Loading engine</span
        >
      </div>
    </header>
    <main>
      <form class="sidebar" id="settings">
        <section class="model-section">
          <h2 class="section-title"><span>00</span>Model</h2>
          <div class="field">
            <label for="model-source">STL model</label
            ><select id="model-source">
              <option value="tux">Tux · included model</option>
              <option id="uploaded-option" value="upload" disabled>
                Uploaded STL
              </option>
            </select>
          </div>
          <button class="secondary" id="upload" type="button">
            ↑ Open STL file</button
          ><input id="stl-file" type="file" accept=".stl" hidden />
          <p class="help" style="margin-top: 9px">
            ASCII or binary STL · coordinates in mm.<br />Files stay on your
            device.
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>01</span>Strategy</h2>
          <div class="field">
            <label for="algorithm">Algorithm</label
            ><select id="algorithm">
              <option value="AdaptivePathDropCutter">
                Adaptive drop-cutter
              </option>
              <option value="PathDropCutter">Uniform drop-cutter</option>
              <option value="AdaptiveWaterline">Adaptive waterline</option>
              <option value="Waterline">Uniform waterline</option>
            </select>
          </div>
          <p class="help" id="algorithm-help">
            Follow the surface in parallel passes, adding samples where its
            shape changes.
          </p>
          <div id="path-options" style="margin-top: 13px">
            <div class="field">
              <label for="pattern">Path pattern</label>
              <select id="pattern">
                <option value="zigzag">Zigzag · alternating passes</option>
                <option value="zig">Zig · one-way passes</option>
                <option value="circles">Concentric circles</option>
                <option value="spiral">Spiral · continuous pass</option>
              </select>
            </div>
            <div class="field" id="scan-field">
              <label for="scan-direction">Scan direction</label>
              <select id="scan-direction">
                <option value="x">+X</option>
                <option value="-x">−X</option>
                <option value="y">+Y</option>
                <option value="-y">−Y</option>
              </select>
            </div>
            <div id="circle-field" hidden>
              <div class="pair">
                <div class="field">
                  <label for="center-x">Center X</label>
                  <div class="input-unit">
                    <input
                      id="center-x"
                      type="number"
                      step="any"
                      value="0"
                      required
                    /><span>mm</span>
                  </div>
                </div>
                <div class="field">
                  <label for="center-y">Center Y</label>
                  <div class="input-unit">
                    <input
                      id="center-y"
                      type="number"
                      step="any"
                      value="0"
                      required
                    /><span>mm</span>
                  </div>
                </div>
              </div>
              <div class="pair">
                <div class="field">
                  <label for="inner-radius">Inner radius</label>
                  <div class="input-unit">
                    <input
                      id="inner-radius"
                      type="number"
                      min="0"
                      step="any"
                      value="0"
                      required
                    /><span>mm</span>
                  </div>
                </div>
                <div class="field">
                  <label for="outer-radius">Outer radius</label>
                  <div class="input-unit">
                    <input
                      id="outer-radius"
                      type="number"
                      min="0.000001"
                      step="any"
                      value="5"
                      required
                    /><span>mm</span>
                  </div>
                </div>
              </div>
              <button class="secondary" id="fit-circles" type="button">
                Fit to model
              </button>
              <div class="field" style="margin-top: 13px">
                <label for="circle-direction">Rotation</label>
                <select id="circle-direction">
                  <option value="ccw">Counterclockwise</option>
                  <option value="cw">Clockwise</option>
                </select>
              </div>
              <div class="pair">
                <div class="field">
                  <label for="radial-order">Radial order</label>
                  <select id="radial-order">
                    <option value="outward">Outward</option>
                    <option value="inward">Inward</option>
                  </select>
                </div>
                <div class="field">
                  <label for="start-angle">Start angle (°)</label>
                  <input
                    id="start-angle"
                    type="number"
                    step="any"
                    value="0"
                    required
                  />
                </div>
              </div>
              <p class="help">
                Radii locate the cutter tip. 0° starts on +X; 90° on +Y. Fit
                uses the model center and corners plus half the cutter diameter.
              </p>
              <div class="field" id="spiral-field" hidden>
                <label for="spiral-tolerance">Spiral XY tolerance</label>
                <div class="input-unit">
                  <input
                    id="spiral-tolerance"
                    type="number"
                    min="0.000001"
                    step="any"
                    value="0.001"
                    required
                  /><span>mm</span>
                </div>
                <p class="help">
                  Maximum deviation of the spiral’s line approximation in XY,
                  before surface projection and optional filtering.
                </p>
              </div>
            </div>
            <p class="help" id="pattern-help">
              Separate passes cover the model bounds, with half a cutter
              diameter of margin.
            </p>
          </div>
          <div class="field" id="weave-field" hidden style="margin-top: 13px">
            <label for="weave">Contour weave</label>
            <select id="weave">
              <option value="simple">Simple weave</option>
              <option value="smart">Smart weave</option>
            </select>
            <p class="help">
              Choose how sampled fibers are joined into closed contours. Smart
              weave reduces the internal graph.
            </p>
          </div>
        </section>
        <section>
          <h2 class="section-title"><span>02</span>Cutter</h2>
          <div class="field">
            <label for="cutter-preset">Cutter preset</label
            ><select id="cutter-preset">
              <option value="ball">0.8 mm ball nose</option>
              <option value="flat">1 mm flat end mill</option>
              <option value="bull">1 mm bull nose · R0.2</option>
              <option value="cone">1 mm V-bit · 60°</option>
              <option value="custom">Custom dimensions</option>
            </select>
          </div>
          <div class="field">
            <label for="cutter">Cutter type</label
            ><select id="cutter">
              <option value="BallCutter">Ball nose</option>
              <option value="CylCutter">Flat end mill</option>
              <option value="BullCutter">Bull nose</option>
              <option value="ConeCutter">Conical</option>
            </select>
          </div>
          <div class="pair">
            <div class="field">
              <label for="diameter">Diameter</label>
              <div class="input-unit">
                <input
                  id="diameter"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.8"
                  required
                /><span>mm</span>
              </div>
            </div>
            <div class="field">
              <label for="length">Length</label>
              <div class="input-unit">
                <input
                  id="length"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="10"
                  required
                /><span>mm</span>
              </div>
            </div>
          </div>
          <div class="field" id="radius-field" hidden>
            <label for="radius">Corner radius</label>
            <div class="input-unit">
              <input
                id="radius"
                type="number"
                min="0.000001"
                step="any"
                value="0.15"
              /><span>mm</span>
            </div>
          </div>
          <div class="field" id="angle-field" hidden>
            <label for="angle">Included tip angle</label>
            <div class="input-unit">
              <input
                id="angle"
                type="number"
                min="10"
                max="150"
                step="5"
                value="60"
              /><span>deg</span>
            </div>
          </div>
          <p class="help">
            Length is measured from the tip. Presets fit the loaded model;
            waterlines need enough length to reach its top. The preview shows
            the cutter used for the last generated path.
          </p>
        </section>
        <section>
          <h2 class="section-title"><span>03</span>Sampling</h2>
          <div
            class="sampling-presets"
            id="sampling-presets"
            role="group"
            aria-label="Sampling presets"
            aria-describedby="sampling-preset-help"
          ></div>
          <p class="help" id="sampling-preset-help" style="margin-bottom: 13px">
            Sample / minimum spacing in mm. Fine is the default. Your values
            stay unchanged when loading another model.
          </p>
          <div class="pair">
            <div class="field">
              <label for="sampling">Sample spacing</label>
              <div class="input-unit">
                <input
                  id="sampling"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.05"
                  required
                /><span>mm</span>
              </div>
            </div>
            <div class="field" id="min-field">
              <label for="min-sampling">Min. spacing</label>
              <div class="input-unit">
                <input
                  id="min-sampling"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.005"
                /><span>mm</span>
              </div>
            </div>
          </div>
          <p
            class="help"
            id="sampling-help"
            style="margin-bottom: 13px"
            aria-live="polite"
          ></p>
          <p class="help" style="margin-bottom: 13px">
            Sampling distance is not machining tolerance. Surface finish also
            depends on pass spacing, step down and STL detail.
          </p>
          <div class="pair" id="path-fields">
            <div class="field">
              <label for="stepover">Pass spacing</label>
              <div class="input-unit">
                <input
                  id="stepover"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.4"
                /><span>mm</span>
              </div>
            </div>
            <div class="field">
              <label for="floor">Minimum Z</label>
              <div class="input-unit">
                <input id="floor" type="number" step="any" value="-3" /><span
                  >mm</span
                >
              </div>
            </div>
          </div>
          <div id="water-fields" hidden>
            <div class="pair">
              <div class="field">
                <label for="height">Start Z</label>
                <div class="input-unit">
                  <input id="height" type="number" step="any" value="2" /><span
                    >mm</span
                  >
                </div>
              </div>
              <div class="field">
                <label for="layers">Z levels</label
                ><input id="layers" type="number" min="1" step="1" value="1" />
              </div>
            </div>
            <div class="pair" style="margin-bottom: 13px">
              <button
                class="secondary"
                id="height-model-top"
                type="button"
                aria-controls="height"
              >
                Model top</button
              ><button
                class="secondary"
                id="height-top-step"
                type="button"
                aria-controls="height"
              >
                Top − step
              </button>
            </div>
            <div class="field">
              <label for="z-step">Step down</label>
              <div class="input-unit">
                <input
                  id="z-step"
                  type="number"
                  min="0.000001"
                  step="any"
                  value="0.5"
                /><span>mm</span>
              </div>
            </div>
            <p class="help" style="margin-bottom: 13px">
              The exact top may have no contour. Top − step starts one step
              down. Start with one level to preview; each extra level repeats
              the calculation.
            </p>
          </div>
          <div class="field">
            <label for="threads">Compute threads</label
            ><select id="threads" disabled>
              <option value="1">1 thread</option>
            </select>
          </div>
          <p class="help" id="thread-help">
            Preparing the embedded CAM engine…
          </p>
          <div class="field" style="margin-top: 13px">
            <label for="path-filter">Output filtering</label>
            <select id="path-filter">
              <option value="none">Keep all points</option>
              <option value="line">Line filter · reduce points</option>
            </select>
          </div>
          <div class="field" id="filter-field" hidden>
            <label for="filter-tolerance">Filter tolerance</label>
            <div class="input-unit">
              <input
                id="filter-tolerance"
                type="number"
                min="0.000001"
                step="any"
                value="0.001"
                required
              /><span>mm</span>
            </div>
            <p class="help">
              Remove nearly collinear points within each pass or contour. This
              changes the path; inspect the result before export.
            </p>
          </div>
        </section>
        <section>
          <h2 class="section-title"><span>04</span>Display</h2>
          <div class="visibility">
            <label class="check"
              ><input id="show-model" type="checkbox" checked />Model</label
            ><label class="check"
              ><input id="show-path" type="checkbox" checked />Toolpath</label
            ><label class="check"
              ><input id="wireframe" type="checkbox" />Wireframe</label
            ><label class="check"
              ><input id="show-cutter" type="checkbox" />Cutter</label
            >
          </div>
        </section>
        <div class="actions">
          <p id="error" class="error" role="alert" hidden></p>
          <button class="primary" id="run" type="submit" disabled>
            <span aria-hidden="true">↗</span
            ><span id="run-label">Preparing model…</span>
          </button>
          <p class="help">All calculations stay in your browser.</p>
        </div>
      </form>
      <section class="workspace" aria-label="Model and toolpath">
        <div class="workspace-title">
          <div>
            <h1>
              <span id="model-title" style="color: inherit; font-weight: 550"
                >Tux</span
              >
              <span>/</span> surface study
            </h1>
            <p class="subtitle">Your surface. Four ways to follow it.</p>
          </div>
          <div class="export-actions">
            <button class="secondary" id="download" disabled>
              ↓ Export points
            </button>
            <button class="secondary" id="export-gcode" disabled>
              Export G-code
            </button>
          </div>
        </div>
        <div class="viewport" id="viewport">
          <canvas
            id="scene"
            aria-label="Interactive 3D model and toolpaths"
          ></canvas>
          <div class="view-top">
            <span class="model-chip" id="model-name">◇ gnu_tux_mod.stl</span>
            <div class="view-buttons" aria-label="Camera views">
              <button type="button" id="iso-view" title="Isometric view">
                Iso</button
              ><button type="button" id="top-view" title="Top view">Top</button
              ><button
                type="button"
                id="fit-view"
                title="Fit model and visible cutter"
              >
                Fit
              </button>
            </div>
          </div>
          <div class="legend">
            <span><i class="swatch model"></i>Surface</span
            ><span><i class="swatch"></i>Cutter-tip path</span>
          </div>
          <div class="axis" aria-hidden="true"><b>X</b><b>Y</b><b>Z</b></div>
          <div id="status" class="status busy" role="status" aria-live="polite">
            Loading the Tux model…
          </div>
          <span class="view-hint"
            >Drag to orbit · scroll to zoom · right-drag to pan</span
          >
          <div id="loading-overlay" class="loading-overlay" hidden>
            <div class="loading-card">
              <div class="loading-spinner" aria-hidden="true"></div>
              <strong id="loading-title">Generating toolpath</strong>
              <p id="loading-stage">Preparing calculation…</p>
              <progress
                id="loading-progress"
                aria-label="Completed Z levels"
              ></progress>
              <div class="loading-meta">
                <output id="loading-elapsed" aria-label="Elapsed time"
                  >0.0 s elapsed</output
                ><button type="button" class="secondary" id="loading-cancel">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="playback">
          <button
            class="secondary"
            id="play"
            disabled
            aria-label="Play cutter preview"
          >
            ▶</button
          ><label for="scrub" class="sr-only"
            >Cutter position along the toolpath</label
          ><input
            type="range"
            id="scrub"
            min="0"
            max="1000"
            step="1"
            value="0"
            disabled
          /><output id="scrub-value">0%</output
          ><span class="small-note">Preview</span>
        </div>
        <div
          class="tip-readout"
          id="tip-readout"
          data-empty="true"
          aria-label="Cutter tip position in model coordinates"
        >
          <strong>Cutter tip</strong
          ><span class="tip-coordinate"
            ><b>X</b
            ><output id="tip-x" aria-live="off" aria-label="Cutter tip X"
              >—</output
            ><small>mm</small></span
          ><span class="tip-coordinate"
            ><b>Y</b
            ><output id="tip-y" aria-live="off" aria-label="Cutter tip Y"
              >—</output
            ><small>mm</small></span
          ><span class="tip-coordinate z"
            ><b>Z</b
            ><output id="tip-z" aria-live="off" aria-label="Cutter tip Z"
              >—</output
            ><small>mm</small></span
          ><span class="tip-context" id="tip-context"
            >Generate a toolpath to inspect its coordinates.</span
          >
        </div>
        <div class="stats" aria-label="Last calculation statistics">
          <div class="stat">
            <label>Compute time</label><strong id="stat-time">—</strong
            ><small id="time-unit">ms</small>
          </div>
          <div class="stat">
            <label>Toolpath points</label><strong id="stat-points">—</strong>
          </div>
          <div class="stat">
            <label>Path length</label><strong id="stat-length">—</strong
            ><small>mm</small>
          </div>
          <div class="stat">
            <label id="paths-label">Passes</label
            ><strong id="stat-paths">—</strong>
          </div>
        </div>
        <div class="footer">
          <span id="model-info">Embedded Tux model · millimeters</span
          ><span id="detail-stats">OpenCAMLib · Three.js</span>
        </div>
      </section>
    </main>
    <dialog id="gcode-dialog" aria-labelledby="gcode-title">
      <div class="dialog-heading">
        <h2 id="gcode-title">Export G-code</h2>
        <button
          type="button"
          class="secondary"
          id="gcode-close"
          aria-label="Close G-code export"
        >
          Close
        </button>
      </div>
      <p class="help" id="gcode-summary"></p>
      <form id="gcode-form">
        <div class="pair">
          <div class="field">
            <label for="gcode-retract">Retract Z</label>
            <div class="input-unit">
              <input
                id="gcode-retract"
                type="number"
                step="any"
                required
              /><span>mm</span>
            </div>
          </div>
          <div class="field">
            <label for="gcode-offset">Work coordinates</label>
            <select id="gcode-offset">
              <option>G54</option>
              <option>G55</option>
              <option>G56</option>
              <option>G57</option>
              <option>G58</option>
              <option>G59</option>
            </select>
          </div>
          <div class="field">
            <label for="gcode-feed">Cutting feed</label>
            <div class="input-unit">
              <input
                id="gcode-feed"
                type="number"
                min="0.001"
                step="any"
                value="300"
                required
              /><span>mm/min</span>
            </div>
          </div>
          <div class="field">
            <label for="gcode-plunge">Plunge feed</label>
            <div class="input-unit">
              <input
                id="gcode-plunge"
                type="number"
                min="0.001"
                step="any"
                value="100"
                required
              /><span>mm/min</span>
            </div>
          </div>
          <div class="field">
            <label for="gcode-spindle">Spindle</label>
            <select id="gcode-spindle">
              <option value="cw">Clockwise · M3</option>
              <option value="ccw">Counterclockwise · M4</option>
              <option value="off">Manual control</option>
            </select>
          </div>
          <div class="field">
            <label for="gcode-rpm">Spindle speed</label>
            <div class="input-unit">
              <input
                id="gcode-rpm"
                type="number"
                min="1"
                step="1"
                value="12000"
                required
              /><span>rpm</span>
            </div>
          </div>
          <div class="field">
            <label for="gcode-dwell">Spindle start delay</label>
            <div class="input-unit">
              <input
                id="gcode-dwell"
                type="number"
                min="0"
                step="any"
                value="1"
                required
              /><span>s</span>
            </div>
          </div>
          <div class="field">
            <label for="gcode-coolant">Coolant</label>
            <select id="gcode-coolant">
              <option value="off">Off · M9</option>
              <option value="flood">Flood · M8</option>
            </select>
          </div>
          <div class="field">
            <label for="gcode-decimals">Decimal places</label>
            <select id="gcode-decimals">
              <option>3</option>
              <option selected>4</option>
              <option>5</option>
              <option>6</option>
            </select>
          </div>
        </div>
        <p class="help">
          Absolute millimeter coordinates match the model origin. Retract Z is
          an absolute height above the model, stock and fixtures. Every pass
          retracts before an XY rapid, then plunges at the plunge feed. Rapid
          speed is set by the controller.
        </p>
        <p class="help" style="margin-top: 8px">
          These are surface-finishing paths, with no stock, clamp or holder
          collision checks. Set feeds and spindle speed for your tool and
          material, match your work zero to the model, and verify the program
          with a dry run.
        </p>
        <p id="gcode-error" class="error" role="alert" hidden></p>
        <button class="primary" id="gcode-generate" type="submit">
          Generate G-code
        </button>
      </form>
      <div id="gcode-output" hidden>
        <label for="gcode-preview">Generated G-code</label>
        <textarea id="gcode-preview" readonly spellcheck="false"></textarea>
        <p class="help" id="gcode-info" aria-live="polite"></p>
        <button class="primary" id="gcode-download" type="button" disabled>
          ↓ Download .nc
        </button>
      </div>
    </dialog>
    <noscript>This interactive app requires JavaScript.</noscript>
    <script id="cam-source">
      @@CAM@@
    </script>
    <script type="application/octet-stream" id="asset-stl">
      @@STL@@
    </script>
    <script type="application/octet-stream" id="asset-serial">
      @@SERIAL@@
    </script>
    <script type="application/octet-stream" id="asset-threaded">
      @@THREADED@@
    </script>
    <script type="text/plain" id="worker-source">
      @@WORKER@@
    </script>
    <script>
      @@BOOTSTRAP@@
    </script>
    <script type="module">
      @@APP@@
    </script>
  </body>
</html>
